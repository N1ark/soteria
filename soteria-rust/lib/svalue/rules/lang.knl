(* The value language of soteria-rust: the shared modules of the
   Bv_values language (bool, built into kanon; exists, bitvec, float, ptr and
   the view of the host code) plus the [rust] module, which adds the aggregates
   (tuples, arrays, enums, unions), the thin and full pointers, the metadata of
   pointers and the polymorphic values. Kanon generates the types
   ([Rust_types]) and the simplifying smart constructors ([Rust_rules]).

   The path of the shared modules is written ONCE, here, in the [use]s below:
   change it when they move. The text of [var], [float], [checked], [fp],
   [rm], [fc], [Var], [Seq] and [TSeq] below is that of the lang.knl of the C
   language: the view functions of the shared [view] module mention [Var] and
   [Seq]. *)

[@@@lean_root "Kanon"]
[@@@lean_param "FS" "FloatSem"]
[@@@ocaml_prims "Rust_prims"]
[@@@ocaml_types "Rust_types"]

[@@@ghost "sint" "[ `NonZero | `Zero ]"]
[@@@ghost "sint_ovf" "[ sint | `Overflowed ]"]
[@@@ghost "nonzero" "[ `NonZero ]"]
[@@@ghost "zero" "[ `Zero ]"]
[@@@ghost "sfloat" "[ `Float ]"]
[@@@ghost "sptr" "[ `Ptr ]"]
[@@@ghost "sloc" "[ `Loc ]"]
[@@@ghost "'a sseq" "[ `List of 'a ]"]
[@@@ghost "cval" "[ sint | sptr | sfloat ]"]

(* The tags of the Rust values, as in soteria-rust/lib/svalue/typed.ml *)
[@@@ghost "sptr_f" "[ `FullPtr ]"]
[@@@ghost "sptr_t" "[ `ThinPtr ]"]
[@@@ghost "tuple" "[ `Tuple ]"]
[@@@ghost "enum" "[ `Enum ]"]
[@@@ghost "union" "[ `Union ]"]
[@@@ghost "poly" "[ `Poly ]"]
[@@@ghost "scalar" "[ sint | sfloat | sptr_f | poly ]"]
[@@@ghost "aggregate" "[ tuple | enum | union ]"]
[@@@ghost "any" "[ scalar | aggregate ]"]

use builtin "bool"
use "../../../../soteria/lib/bv_values/rules/exists"
use "../../../../soteria/lib/bv_values/rules/bitvec"
use "../../../../soteria/lib/bv_values/rules/float"
use "../../../../soteria/lib/bv_values/rules/ptr"

type var [@ocaml "Soteria.Symex.Var.t"] [@lean "Int"]
    [@equal "Soteria.Symex.Var.equal"] [@hash "Soteria.Symex.Var.hash"]

(* Floats are compared and hashed bit by bit ([NaN] is equal to itself) *)
type float [@ocaml "Floatml.AnyFloat.t"] [@noeq]
    [@equal "Floatml.AnyFloat.equal"] [@hash "Floatml.AnyFloat.hash"]

type checked [@ocaml "Soteria.Bv_values.Bv_base.checked"] =
  { signed : bool; unsigned : bool }

node Var of var
node Seq of t list

sort TSeq of ty [@ghost sseq]

type fp [@ocaml "Soteria.Bv_values.Bv_base.FloatPrecision.t"] =
  | F16
  | F32
  | F64
  | F128

type rm [@ocaml "Soteria.Bv_values.Bv_base.RoundingMode.t"] =
  | NearestTiesToEven
  | Truncate
  | Ceil
  | Floor
  | NearestTiesToAway

type fc [@ocaml "Soteria.Bv_values.Bv_base.FloatClass.t"] =
  | Normal
  | Subnormal
  | Zero
  | Infinite
  | NaN

use "../../../../soteria/lib/bv_values/rules/view"
use "rust"
