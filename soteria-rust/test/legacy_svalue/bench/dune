; The cost of the arrays (both [Iarray]: old hand-written values, new Kanon language).

(rule
 (targets old_side.ml)
 (deps old_prelude.ml body.ml)
 (action
  (with-stdout-to
   old_side.ml
   (progn
    (cat old_prelude.ml)
    (cat body.ml)))))

(rule
 (targets new_side.ml)
 (deps new_prelude.ml body.ml)
 (action
  (with-stdout-to
   new_side.ml
   (progn
    (cat new_prelude.ml)
    (cat body.ml)))))

(executable
 (name bench)
 (modules old_side new_side bench)
 (libraries legacy_svalue soteria soteria-rust charon fmt iter zarith)
 (flags
  (:standard -open Soteria.Bv_values -w +a-4-9-26-27-32..42-44-45-48-70)))

(rule
 (alias bench)
 (action
  (run ./bench.exe)))
