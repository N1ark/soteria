; The differential test of the Rust value language: the OLD stack
; (soteria-rust/lib/svalue, built from the extension of the generic Svalue) and
; the NEW one (rules generated by Kanon, ../rust_typed.ml), on the same random
; Rust values built through the same public interface, in lock step, compared
; structurally (neutral.ml). See ../README.md.

(rule
 (targets old_side.ml)
 (deps old_prelude.ml body.ml)
 (action
  (with-stdout-to
   old_side.ml
   (progn
    (cat old_prelude.ml)
    (cat body.ml)))))

(rule
 (targets new_side.ml)
 (deps new_prelude.ml body.ml)
 (action
  (with-stdout-to
   new_side.ml
   (progn
    (cat new_prelude.ml)
    (cat body.ml)))))

(executable
 (name rust_diff)
 (modules
  neutral
  old_conv
  new_conv
  old_side
  new_side
  mut_conv
  mut_side
  compare
  mutants
  rust_diff)
 (libraries
  mutations
  rust_new
  rust_mut
  soteria
  soteria-rust
  charon
  fmt
  iter
  zarith)
 (flags
  (:standard -open Soteria.Bv_values -w +a-4-9-26-27-32..42-44-45-48-70)))

(rule
 (targets mut_conv.ml)
 (deps new_conv.ml)
 (action
  (with-stdout-to
   mut_conv.ml
   (run sed "s/Rust_new/Rust_mut/g" new_conv.ml))))

(rule
 (targets mut_side.ml)
 (deps mut_prelude.ml body.ml)
 (action
  (with-stdout-to
   mut_side.ml
   (progn
    (cat mut_prelude.ml)
    (cat body.ml)))))

(library
 (name mutations)
 (modules mutations))

(executable
 (name mutate)
 (modules mutate)
 (libraries mutations)
 (flags
  (:standard -w +a-4-9-26-27-32..42-44-45-48-70)))

; 20 chunks, and the self-test: the mutants of the new stack must be detected.
; Longer runs: rust_diff.exe --chunks 2000 (see ../README.md).

(rule
 (alias runtest)
 (package soteria-rust)
 (action
  (run ./rust_diff.exe --chunks 20 --quiet)))

(rule
 (alias runtest)
 (package soteria-rust)
 (action
  (run ./rust_diff.exe --self-test --chunks 10)))
