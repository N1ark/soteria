(rule
 (targets rust_rules.ml)
 (deps ../../../../lib/svalue/rust_rules.gen.ml)
 (action
  (with-stdout-to
   rust_rules.ml
   (run ../mutate.exe ../../../../lib/svalue/rust_rules.gen.ml))))

(library
