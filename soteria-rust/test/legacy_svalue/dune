; The standalone value language of soteria-rust, generated by Kanon from the
; shared modules of the Bv_values language and the rust module: see README.md.
; The generated files are committed (see regen.sh) and are not generated by
; dune: the kanon of the dune environment is the old, pinned one. Dune ignores
; file names with two dots as modules, hence the copies.

(rule
 (copy rust_types.gen.ml rust_types.ml))

(rule
 (copy rust_rules.gen.ml rust_rules.ml))

(library
 (name rust_new)
 (modules
  iface
  rust_host
  rust_types
  base_view_prims
  base_prims
  rust_charon
  rust_encoding
  rust_prims
  rust_rules
  rust_lang
  rust_stack
  rust_typed)
 (libraries soteria soteria-rust charon floatml iter zarith fmt)
 ; the generated types mention [View_host] (see rules/view.knl)
 (flags
  (:standard -open Soteria.Bv_values -w +a-4-9-26-27-32..42-44-45-48-70)))
