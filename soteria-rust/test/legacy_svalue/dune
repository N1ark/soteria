; FROZEN COPY of the OLD Rust values (the extension [Ext] of the generic
; Svalue, the encoding and the typed layer that soteria-rust/lib/svalue had
; before the language was generated by Kanon), kept for the differential test of
; diff/ and the benchmark of bench/, which compare it with the new language.
; Stage S7 of the migration deletes this directory, with the old stack of
; Soteria.Bv_values (Svalue.Make, Value_ext, Typed.Make, ...) that it uses.

(library
 (name legacy_svalue)
 (libraries soteria soteria-rust charon fmt iter zarith)
 (flags
  (:standard
   -open
   Soteria.Soteria_std
   -open
   Soteria.Bv_values
   -open
   Soteria_rust_lib))
 (preprocess
  (pps
   ppx_deriving.std
   ppx_deriving_yojson
   ppx_subliner
   soteria.ppx
   soteria-rust.ppx
   ppx_deriving_hash
   ppx_matches
   ppx_mixins)))
