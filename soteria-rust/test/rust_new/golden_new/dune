; The Rust golden dump of soteria-rust/test/golden/golden.ml, run on the stack of
; the new language: golden_new.ml is that file with ONLY the alias [Ty] changed
; (the shim only uses [Soteria_rust_lib.Crate], which both stacks share). The
; output must be BYTE-IDENTICAL to golden.expected, which the old stack
; produces: no location text of an assertion appears in it.

(executable
 (name golden_new)
 (libraries rust_new soteria soteria-rust charon fmt iter zarith)
 (flags
  (:standard -open Soteria.Bv_values)))

(rule
 (targets golden_new.actual)
 (action
  (with-stdout-to
   golden_new.actual
   (run ./golden_new.exe))))

(rule
 (alias runtest)
 (package soteria-rust)
 (action
  (diff ../../golden/golden.expected golden_new.actual)))
