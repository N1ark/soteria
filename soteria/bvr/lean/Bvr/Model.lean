                         some (v_true)
                         | _ => none),
            (match (distinct_check l) with
              | (some false) =>
              some (v_false)
              | _ => none),
            (match (distinct_check l) with
              | none =>
              some ((Term.mk (Kind.nop Nop.distinct (O.orc.sort_by_tag l)) Ty.bool))
              | _ => none)]).getD
            Inhabited.default)))

