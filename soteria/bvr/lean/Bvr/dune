; The Lean types of the language, and the model, statements and assembly proof
; of the rules, are generated from lang.bvl and the rules;
; `dune test` checks that the committed files are up to date (run `dune
; promote` after changing the rules), and CI checks them with `lake build`.

(rule
 (deps
  %{project_root}/soteria/lib/bv_values/rules/lang.bvl
  (glob_files %{project_root}/soteria/lib/bv_values/rules/*.bvr))
 (targets
  Types.lean.gen
  Syntax.lean.gen
  Model.lean.gen
  Statements.lean.gen
  Lifts.lean.gen
  Soundness.lean.gen)
 (action
  (progn
   (with-stdout-to
    Types.lean.gen
    (run
     %{exe:../../main.exe}
     lean-types
     %{project_root}/soteria/lib/bv_values/rules/lang.bvl))
   (with-stdout-to
    Syntax.lean.gen
    (run
     %{exe:../../main.exe}
     lean-syntax
     %{project_root}/soteria/lib/bv_values/rules/lang.bvl))
   (with-stdout-to
    Model.lean.gen
    (run
     %{exe:../../main.exe}
     lean-model
     %{project_root}/soteria/lib/bv_values/rules/lang.bvl
     %{project_root}/soteria/lib/bv_values/rules/prelude.bvr
     %{project_root}/soteria/lib/bv_values/rules/bool.bvr
     %{project_root}/soteria/lib/bv_values/rules/bitvec.bvr
     %{project_root}/soteria/lib/bv_values/rules/float.bvr
     %{project_root}/soteria/lib/bv_values/rules/ptr.bvr))
   (with-stdout-to
    Statements.lean.gen
    (run
     %{exe:../../main.exe}
     lean-statements
     %{project_root}/soteria/lib/bv_values/rules/lang.bvl
     %{project_root}/soteria/lib/bv_values/rules/prelude.bvr
     %{project_root}/soteria/lib/bv_values/rules/bool.bvr
     %{project_root}/soteria/lib/bv_values/rules/bitvec.bvr
     %{project_root}/soteria/lib/bv_values/rules/float.bvr
     %{project_root}/soteria/lib/bv_values/rules/ptr.bvr))
   (with-stdout-to
    Lifts.lean.gen
    (run
     %{exe:../../main.exe}
     lean-lifts
     %{project_root}/soteria/lib/bv_values/rules/lang.bvl
     %{project_root}/soteria/lib/bv_values/rules/prelude.bvr
     %{project_root}/soteria/lib/bv_values/rules/bool.bvr
     %{project_root}/soteria/lib/bv_values/rules/bitvec.bvr
     %{project_root}/soteria/lib/bv_values/rules/float.bvr
     %{project_root}/soteria/lib/bv_values/rules/ptr.bvr))
   (with-stdout-to
    Soundness.lean.gen
    (run
     %{exe:../../main.exe}
     lean-soundness
     %{project_root}/soteria/lib/bv_values/rules/lang.bvl
     %{project_root}/soteria/lib/bv_values/rules/prelude.bvr
     %{project_root}/soteria/lib/bv_values/rules/bool.bvr
     %{project_root}/soteria/lib/bv_values/rules/bitvec.bvr
     %{project_root}/soteria/lib/bv_values/rules/float.bvr
     %{project_root}/soteria/lib/bv_values/rules/ptr.bvr)))))

(rule
 (alias runtest)
 (action
  (progn
   (diff Types.lean Types.lean.gen)
   (diff Syntax.lean Syntax.lean.gen)
   (diff Model.lean Model.lean.gen)
   (diff Statements.lean Statements.lean.gen)
   (diff Lifts.lean Lifts.lean.gen)
   (diff Soundness.lean Soundness.lean.gen))))
