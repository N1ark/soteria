      ∃ n : Int, a = (Ty.TBitVector n) ∧ (0 : Int) ≤ i ∧ i ≤ j ∧ j < n ∧ t = (Ty.TBitVector ((j - i) + (1 : Int)))
  | .BvExtend _ k, a, t =>
      ∃ n : Int, 0 < n ∧ a = (Ty.TBitVector n) ∧ (0 : Int) ≤ k ∧ t = (Ty.TBitVector (n + k))
  | .BvNot, a, t | .Neg _, a, t =>
      (∃ n : Int, 0 < n ∧ a = (Ty.TBitVector n)) ∧ t = a
  | .FAbs, a, t | .FNeg, a, t | .FSqrt, a, t =>
      (∃ p : Fp, a = (Ty.TFloat p)) ∧ t = a
  | .FIs _, a, t | .FIsNeg, a, t | .FIsPos, a, t =>
      (∃ p : Fp, a = (Ty.TFloat p)) ∧ t = Ty.TBool
  | .FRound _, a, t =>
      (∃ p : Fp, a = (Ty.TFloat p)) ∧ t = a

