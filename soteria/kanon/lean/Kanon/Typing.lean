      0 < n ∧ (∃ p : Fp, a = (Ty.TFloat p)) ∧ t = (Ty.TBitVector n)
  | .FloatOfBv _ _ p, a, t =>
      (∃ n : Int, 0 < n ∧ a = (Ty.TBitVector n)) ∧ t = (Ty.TFloat p)
  | .FloatOfBvRaw p, a, t =>
      a = (Ty.TBitVector (fp_size p)) ∧ t = (Ty.TFloat p)
  | .FloatOfFloat _ p, a, t =>
      (∃ q : Fp, a = (Ty.TFloat q)) ∧ t = (Ty.TFloat p)
