; The Lean types of the language, and the model, statements and assembly proof
; of the rules, are generated from the declaration of the language and the
; rules;
; `dune test` checks that the committed files are up to date (run `dune
; promote` after changing the rules), and CI checks them with `lake build`.

(rule
 (deps
  (glob_files %{project_root}/soteria/kanon/modules/*.knl)
  (glob_files %{project_root}/soteria/kanon/modules/*.kn)
  (glob_files %{project_root}/soteria/lib/bv_values/rules/*.knl)
  (glob_files %{project_root}/soteria/lib/bv_values/rules/*.kn))
 (targets
  Types.lean.gen
  Syntax.lean.gen
  Signatures.lean.gen
  Typing.lean.gen
  Model.lean.gen
  Statements.lean.gen
  Lifts.lean.gen
  Soundness.lean.gen)
 (action
  (run
   %{bin:kanon}
   lean-all
   %{project_root}/soteria/lib/bv_values/rules/lang.knl
   +bool.knl
   %{project_root}/soteria/kanon/modules/exists.knl
   %{project_root}/soteria/lib/bv_values/rules/bitvec.knl
   %{project_root}/soteria/lib/bv_values/rules/float.knl
   %{project_root}/soteria/lib/bv_values/rules/ptr.knl
   +bool.kn
   %{project_root}/soteria/kanon/modules/exists.kn
   %{project_root}/soteria/lib/bv_values/rules/bitvec.kn
   %{project_root}/soteria/lib/bv_values/rules/float.kn
   %{project_root}/soteria/lib/bv_values/rules/ptr.kn)))

(rule
 (alias runtest)
 (action
  (progn
   (diff Types.lean Types.lean.gen)
   (diff Syntax.lean Syntax.lean.gen)
   (diff Signatures.lean Signatures.lean.gen)
   (diff Typing.lean Typing.lean.gen)
   (diff Model.lean Model.lean.gen)
   (diff Statements.lean Statements.lean.gen)
   (diff Lifts.lean Lifts.lean.gen)
   (diff Soundness.lean Soundness.lean.gen))))
