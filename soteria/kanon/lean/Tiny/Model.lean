               else (O.lt (int_z (tdiv b a)) v))))))
    | _, _ => none)
  <|> (match v1, v2 with
        | (Term.mk (Kind.Binop Binop.Times (Term.mk (Kind.Int a) _) v) _), (Term.mk (Kind.Int b) _) =>
        (whenSome true
        ((if (decide (a = (0 : Int)))
         then (of_bool (decide ((0 : Int) ≤ b)))
         else (if ((divisible b a) || (decide (b > (0 : Int))))
              then (if (decide ((0 : Int) < a))
                   then (O.leq v (int_z (tdiv b a)))
                   else (O.leq (int_z (tdiv b a)) v))
              else (if (decide ((0 : Int) < a))
                   then (O.lt v (int_z (tdiv b a)))
                   else (O.lt (int_z (tdiv b a)) v))))))
        | _, _ => none)

def leq.r_mod_const (O : Ops) (v1 : Term) (v2 : Term) : Option Term :=
  (match v1, v2 with
    | (Term.mk (Kind.Binop Binop.Mod _ (Term.mk (Kind.Int a) _)) _), (Term.mk (Kind.Int b) _) =>
    (whenSome (decide ((abs a) ≤ b)) (v_true))
    | _, _ => none)
  <|> (match v1, v2 with
        | (Term.mk (Kind.Binop Binop.Rem _ (Term.mk (Kind.Int a) _)) _), (Term.mk (Kind.Int b) _) =>
        (whenSome (decide ((abs a) ≤ b)) (v_true))
        | _, _ => none)

def leq.r_const_rem (O : Ops) (v1 : Term) (v2 : Term) : Option Term :=
  (match v1, v2 with
    | (Term.mk (Kind.Int b) _), (Term.mk (Kind.Binop Binop.Rem _ (Term.mk (Kind.Int a) _)) _) =>
    (whenSome (decide (b ≤ (- (abs a)))) (v_true))
    | _, _ => none)

def leq.r_const_mod (O : Ops) (v1 : Term) (v2 : Term) : Option Term :=
  (match v1, v2 with
    | (Term.mk (Kind.Int b) _), (Term.mk (Kind.Binop Binop.Mod _ _) _) =>
    (whenSome (decide (b ≤ (0 : Int))) (v_true))
    | _, _ => none)

def leq.r_const_ite (O : Ops) (v1 : Term) (v2 : Term) : Option Term :=
  (match v1, v2 with
    | (Term.mk (Kind.Int _) _), (Term.mk (Kind.Ite b l r) _) =>
    (whenSome true ((O.b_ite b (O.leq v1 l) (O.leq v1 r))))
    | _, _ => none)

def leq.r_ite_const (O : Ops) (v1 : Term) (v2 : Term) : Option Term :=
  (match v1, v2 with
    | (Term.mk (Kind.Ite b l r) _), (Term.mk (Kind.Int _) _) =>
    (whenSome true ((O.b_ite b (O.leq l v2) (O.leq r v2))))
    | _, _ => none)

def leq.r_default (O : Ops) (v1 : Term) (v2 : Term) : Option Term :=
  (match v1, v2 with
    | _, _ =>
    (whenSome true ((Term.mk (Kind.Binop Binop.Leq v1 v2) Ty.TBool))))

def leq.step (O : Ops) (v1 : Term) (v2 : Term) : Term :=
  (firstSome [leq.r_lits O v1 v2, leq.r_same O v1 v2, leq.r_self_add O v1 v2, leq.r_add_add O v1 v2, leq.r_add_const O v1 v2, leq.r_const_add O v1 v2, leq.r_sub_const O v1 v2, leq.r_rsub_const O v1 v2, leq.r_const_sub O v1 v2, leq.r_const_rsub O v1 v2, leq.r_const_mul O v1 v2, leq.r_mul_const O v1 v2, leq.r_mod_const O v1 v2, leq.r_const_rem O v1 v2, leq.r_const_mod O v1 v2, leq.r_const_ite O v1 v2, leq.r_ite_const O v1 v2, leq.r_default O v1 v2]).getD (leq.spec v1 v2)

def opsRaw (orc : Oracle) : Ops :=
  { orc := orc,
    b_and := fun v1 v2 => b_and.spec v1 v2,
    b_or := fun v1 v2 => b_or.spec v1 v2,
    b_not := fun sv => b_not.spec sv,
    b_ite := fun guard if_ else_ => b_ite.spec guard if_ else_,
    sem_eq := fun v1 v2 => sem_eq.spec v1 v2,
    sem_eq_untyped := fun v1 v2 => sem_eq_untyped.spec v1 v2,
    b_distinct := fun l => b_distinct.spec l,
    add := fun v1 v2 => add.spec v1 v2,
    sub := fun v1 v2 => sub.spec v1 v2,
    mul := fun v1 v2 => mul.spec v1 v2,
    div := fun v1 v2 => div.spec v1 v2,
    rem := fun v1 v2 => rem.spec v1 v2,
    mod_ := fun v1 v2 => mod_.spec v1 v2,
    neg := fun v => neg.spec v,
    lt := fun v1 v2 => lt.spec v1 v2,
    leq := fun v1 v2 => leq.spec v1 v2 }

def opsStep (O : Ops) : Ops :=
  { orc := O.orc,
    b_and := b_and.step O,
    b_or := b_or.step O,
    b_not := b_not.step O,
    b_ite := b_ite.step O,
    sem_eq := sem_eq.step O,
    sem_eq_untyped := sem_eq_untyped.step O,
    b_distinct := b_distinct.step O,
    add := add.step O,
    sub := sub.step O,
    mul := mul.step O,
    div := div.step O,
    rem := rem.step O,
    mod_ := mod_.step O,
    neg := neg.step O,
    lt := lt.step O,
    leq := leq.step O }

def opsN (orc : Oracle) : Nat → Ops
  | 0 => opsRaw orc
  | n + 1 => opsStep (opsN orc n)

end Tiny
