; The smart constructors are generated from the rules, and promoted to the
; source tree so that they are committed and reviewed with them.

(rule
 (targets svalue_rules.gen.ml)
 (mode promote)
 (deps
  (glob_files ../../kanon/modules/*.knl)
  (glob_files ../../kanon/modules/*.kn)
  (glob_files rules/*.knl)
  (glob_files rules/*.kn))
 (action
  (with-stdout-to
   %{targets}
   (run
    %{bin:kanon}
    ocaml
    rules/lang.knl
    +bool.knl
    ../../kanon/modules/exists.knl
    rules/bitvec.knl
    rules/float.knl
    rules/ptr.knl
    +bool.kn
    ../../kanon/modules/exists.kn
    rules/bitvec.kn
    rules/float.kn
    rules/ptr.kn))))

; The check that the OCaml types of the language agree with its declaration.

(rule
 (targets lang_check.gen.ml)
 (mode promote)
 (deps
  (glob_files ../../kanon/modules/*.knl)
  (glob_files rules/*.knl))
 (action
  (with-stdout-to
   %{targets}
   (run
    %{bin:kanon}
    ocaml-check
    rules/lang.knl
    +bool.knl
    ../../kanon/modules/exists.knl
    rules/bitvec.knl
    rules/float.knl
    rules/ptr.knl))))
