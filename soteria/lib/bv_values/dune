; The types and the simplifying smart constructors of the language of the C
; tool are generated by Kanon from the rules in rules/, and promoted to the
; source tree, where they are committed and reviewed with them. Dune ignores
; the file names with two dots as modules, hence the copies.

(rule
 (targets bv_types.gen.ml)
 (mode promote)
 (deps
  (glob_files rules/*.{kn,knl}))
 (action
  (with-stdout-to
   %{targets}
   (run %{bin:kanon} ocaml-types rules/lang.knl))))

(rule
 (targets bv_rules.gen.ml)
 (mode promote)
 (deps
  (glob_files rules/*.{kn,knl}))
 (action
  (with-stdout-to
   %{targets}
   (run %{bin:kanon} ocaml rules/lang.knl))))

(rule
 (copy bv_types.gen.ml bv_types.ml))

(rule
 (copy bv_rules.gen.ml bv_rules.ml))

; svalue_rules.gen.ml and lang_check.gen.ml, which the old Svalue includes (for
; soteria-rust until it moves to the new language), are FROZEN: they were
; generated by the old Kanon from legacy_rules/ (old syntax, which the pinned
; Kanon does not read) and are no longer regenerated.
