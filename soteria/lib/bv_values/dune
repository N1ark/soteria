; The smart constructors are generated from the rules, and promoted to the
; source tree so that they are committed and reviewed with them.

(rule
 (targets svalue_rules.gen.ml)
 (mode promote)
 (deps
  (glob_files rules/*.bvl)
  (glob_files rules/*.bvr))
 (action
  (with-stdout-to
   %{targets}
   (run
    %{exe:../../bvr/main.exe}
    ocaml
    rules/lang.bvl
    rules/bool.bvl
    rules/bitvec.bvl
    rules/float.bvl
    rules/ptr.bvl
    rules/prelude.bvr
    rules/bool.bvr
    rules/bitvec.bvr
    rules/float.bvr
    rules/ptr.bvr))))

; The check that the OCaml types of the language agree with its declaration.

(rule
 (targets lang_check.gen.ml)
 (mode promote)
 (deps
  (glob_files rules/*.bvl))
 (action
  (with-stdout-to
   %{targets}
   (run
    %{exe:../../bvr/main.exe}
    ocaml-check
    rules/lang.bvl
    rules/bool.bvl
    rules/bitvec.bvl
    rules/float.bvl
    rules/ptr.bvl))))
