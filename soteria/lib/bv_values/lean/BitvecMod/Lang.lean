@[kanon_atom_cases] theorem ev_cases {S : Kanon.Sem} [KanonBool.Lang S] [CoreMod.Lang S] [Lang S] [Typed S] {ρ : S.Env}
    {e : S.Term} {s : Srt} (w : S.WT e) (h : S.ty e = sort s) :
