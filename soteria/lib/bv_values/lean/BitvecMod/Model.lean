     then (BitvecMod.mk (.MulOvf signed v1 v2) (KanonBool.sort .TBool))
     else (BitvecMod.mk (.MulOvf signed v2 v1) (KanonBool.sort .TBool))))))

def Bitvec.neg_overflows.r_main (O : Ops S) (v : S.Term) : Option S.Term :=
  (whenSome true
  ((O.bool_eq (BitvecMod.mk_masked (BitvecMod.Bitvec.size v) (BitvecMod.Bitvec.min_for true (BitvecMod.Bitvec.size v))) v)))

def Bitvec.sub_overflows.r_lits (O : Ops S) (signed : Bool) (v1 : S.Term) (v2 : S.Term) : Option S.Term :=
  (match (BitvecMod.proj v1), v1, (BitvecMod.proj v2), v2 with
    | some (.BitVec i1), lit_i1, some (.BitVec i2), lit_i2 =>
    (whenSome true
    ((KanonBool.mk (.Bool (BitvecMod.Bitvec.lit_sub_overflows signed (S.ty lit_i1) (S.ty lit_i2) i1 i2)) (KanonBool.sort .TBool))))
    | _, _, _, _ => none)

def Bitvec.sub_overflows.r_same (O : Ops S) (signed : Bool) (v1 : S.Term) (v2 : S.Term) : Option S.Term :=
  (match v1, v2 with
    | v, kanon__2 =>
    (whenSome (decide (v = kanon__2)) (KanonBool.v_false)))

def Bitvec.sub_overflows.r_unsigned (O : Ops S) (signed : Bool) (v1 : S.Term) (v2 : S.Term) : Option S.Term :=
  (match v1, v2 with
    | _, _ =>
    (whenSome (! signed) ((O.bitvec_lt signed v1 v2))))

def Bitvec.sub_overflows.r_default (O : Ops S) (signed : Bool) (v1 : S.Term) (v2 : S.Term) : Option S.Term :=
  (match v1, v2 with
    | _, _ =>
    (whenSome true
    ((BitvecMod.mk (.SubOvf signed v1 v2) (KanonBool.sort .TBool)))))

/-- What the proofs assume of the model: its rule functions refine their specs, its oracles
and extensible helpers do what they are assumed to do. -/
structure Ops.Sound (O : Ops S) : Prop extends toBoolSound : KanonBool.Ops.Sound O.toBoolOps, toCoreSound : CoreMod.Ops.Sound O.toCoreOps where
  bitvec_of_bool : ∀ (n : Int) (b : S.Term), S.Refines (Bitvec.of_bool.spec n b) (O.bitvec_of_bool n b)
  bitvec_to_bool : ∀ (v : S.Term), S.Refines (Bitvec.to_bool.spec v) (O.bitvec_to_bool v)
  bitvec_not_bool : ∀ (v : S.Term), S.Refines (Bitvec.not_bool.spec v) (O.bitvec_not_bool v)
  bitvec_add : ∀ (checked : CoreMod.Checked) (v1 : S.Term) (v2 : S.Term), S.Refines (Bitvec.add.spec checked v1 v2) (O.bitvec_add checked v1 v2)
  bitvec_sub : ∀ (checked : CoreMod.Checked) (v1 : S.Term) (v2 : S.Term), S.Refines (Bitvec.sub.spec checked v1 v2) (O.bitvec_sub checked v1 v2)
  bitvec_neg : ∀ (checked : Bool) (v : S.Term), S.Refines (Bitvec.neg.spec checked v) (O.bitvec_neg checked v)
  bitvec_mod_ : ∀ (v1 : S.Term) (v2 : S.Term), S.Refines (Bitvec.mod_.spec v1 v2) (O.bitvec_mod_ v1 v2)
  bitvec_rem : ∀ (signed : Bool) (v1 : S.Term) (v2 : S.Term), BitvecMod.Nonzero v2 → S.Refines (Bitvec.rem.spec signed v1 v2) (O.bitvec_rem signed v1 v2)
  bitvec_not_ : ∀ (v : S.Term), S.Refines (Bitvec.not_.spec v) (O.bitvec_not_ v)
  bitvec_and_ : ∀ (v1 : S.Term) (v2 : S.Term), S.Refines (Bitvec.and_.spec v1 v2) (O.bitvec_and_ v1 v2)
  bitvec_or_ : ∀ (v1 : S.Term) (v2 : S.Term), S.Refines (Bitvec.or_.spec v1 v2) (O.bitvec_or_ v1 v2)
  bitvec_xor : ∀ (v1 : S.Term) (v2 : S.Term), S.Refines (Bitvec.xor.spec v1 v2) (O.bitvec_xor v1 v2)
  bitvec_extract : ∀ (from_ : Int) (to_ : Int) (v : S.Term), S.Refines (Bitvec.extract.spec from_ to_ v) (O.bitvec_extract from_ to_ v)
  bitvec_extend_ : ∀ (signed : Bool) (extend_by : Int) (v : S.Term), S.Refines (Bitvec.extend_.spec signed extend_by v) (O.bitvec_extend_ signed extend_by v)
  bitvec_concat : ∀ (v1 : S.Term) (v2 : S.Term), S.Refines (Bitvec.concat.spec v1 v2) (O.bitvec_concat v1 v2)
  bitvec_shl : ∀ (v1 : S.Term) (v2 : S.Term), S.Refines (Bitvec.shl.spec v1 v2) (O.bitvec_shl v1 v2)
  bitvec_lshr : ∀ (v1 : S.Term) (v2 : S.Term), S.Refines (Bitvec.lshr.spec v1 v2) (O.bitvec_lshr v1 v2)
  bitvec_ashr : ∀ (v1 : S.Term) (v2 : S.Term), S.Refines (Bitvec.ashr.spec v1 v2) (O.bitvec_ashr v1 v2)
  bitvec_mul : ∀ (checked : CoreMod.Checked) (v1 : S.Term) (v2 : S.Term), S.Refines (Bitvec.mul.spec checked v1 v2) (O.bitvec_mul checked v1 v2)
  bitvec_div : ∀ (signed : Bool) (v1 : S.Term) (v2 : S.Term), BitvecMod.Nonzero v2 → S.Refines (Bitvec.div.spec signed v1 v2) (O.bitvec_div signed v1 v2)
  bitvec_lt_zero : ∀ (v : S.Term), S.Refines (Bitvec.lt_zero.spec v) (O.bitvec_lt_zero v)
  bitvec_lt : ∀ (signed : Bool) (v1 : S.Term) (v2 : S.Term), S.Refines (Bitvec.lt.spec signed v1 v2) (O.bitvec_lt signed v1 v2)
  bitvec_leq : ∀ (signed : Bool) (v1 : S.Term) (v2 : S.Term), S.Refines (Bitvec.leq.spec signed v1 v2) (O.bitvec_leq signed v1 v2)
  bitvec_add_overflows : ∀ (signed : Bool) (v1 : S.Term) (v2 : S.Term), S.Refines (Bitvec.add_overflows.spec signed v1 v2) (O.bitvec_add_overflows signed v1 v2)
  bitvec_mul_overflows : ∀ (signed : Bool) (v1 : S.Term) (v2 : S.Term), S.Refines (Bitvec.mul_overflows.spec signed v1 v2) (O.bitvec_mul_overflows signed v1 v2)
  bitvec_neg_overflows : ∀ (v : S.Term), S.Refines (Bitvec.neg_overflows.spec v) (O.bitvec_neg_overflows v)
  bitvec_sub_overflows : ∀ (signed : Bool) (v1 : S.Term) (v2 : S.Term), S.Refines (Bitvec.sub_overflows.spec signed v1 v2) (O.bitvec_sub_overflows signed v1 v2)

end BitvecMod
