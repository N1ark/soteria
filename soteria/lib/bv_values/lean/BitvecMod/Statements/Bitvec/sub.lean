  ∀ (checked : CoreMod.Checked) (v1 : S.Term) (v2 : S.Term),
  S.Refines (BitvecMod.Bitvec.sub.spec L checked v1 v2)
  ((B.node (L.SubK checked v1 v2) (S.ty v1)))

end BitvecMod
