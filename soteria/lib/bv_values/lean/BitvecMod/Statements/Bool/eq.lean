  ∀ {S : Kanon.Sem} [KanonBool.Lang S] [CoreMod.Lang S] [BitvecMod.Lang S] [KanonBool.Typed S] [CoreMod.Typed S] [BitvecMod.Typed S] (O : Ops S), O.Sound →
  ∀ (v1 : S.Term) (v2 : S.Term),
  ((BitvecMod.Bitvec.is_bv (S.ty v1)) && ((BitvecMod.Bitvec.is_bv (S.ty v2)) && 
  (let msb := (BitvecMod.Bitvec.zmax (BitvecMod.Bitvec.msb_of v1) (BitvecMod.Bitvec.msb_of v2));
  ((decide ((0 : Int) ≤ msb)) && (decide (msb < ((BitvecMod.Bitvec.size v1) - (1 : Int)))))))) = true →
  S.Refines (KanonBool.Bool.eq.spec v1 v2)
  ((let msb := (BitvecMod.Bitvec.zmax (BitvecMod.Bitvec.msb_of v1) (BitvecMod.Bitvec.msb_of v2));
   (let v1_ := (O.bitvec_extract (0 : Int) msb v1);
   (let v2_ := (O.bitvec_extract (0 : Int) msb v2);
   (O.bool_eq v1_ v2_)))))

end BitvecMod
