  bitvec_is_min_of_eq : ∀ (signed : Bool) (n : Int) (l : Int), (bitvec_is_min_of signed n l) =
      (decide ((bitvec_to_z signed n l) = (bitvec_min_for signed n)))
  bitvec_is_max_of_eq : ∀ (signed : Bool) (n : Int) (l : Int), (bitvec_is_max_of signed n l) =
      (decide ((bitvec_to_z signed n l) = (bitvec_max_for signed n)))
  bitvec_unsigned_ub_eq : ∀ (v : S.Term), (bitvec_unsigned_ub v) =
      ((bitvec_z_lsl (1 : Int) ((bitvec_msb_of v) + (1 : Int))) - (1 : Int))
  bitvec_no_wrap_eq : ∀ (c : CoreMod.Checked) (v1 : S.Term) (v2 : S.Term), (bitvec_no_wrap c v1 v2) =
      (if ((bitvec_is_bv (S.ty v1)) && (decide (((bitvec_unsigned_ub v1) + (bitvec_unsigned_ub v2)) < (bitvec_z_lsl (1 : Int) (bitvec_size v1)))))
      then ({ signed := c.signed, unsigned := true } : CoreMod.Checked)
      else c)
  bitvec_is_checked_unsigned_op_eq : ∀ (v : S.Term), (bitvec_is_checked_unsigned_op v) =
      ((firstSome [(match (asAdd v) with
                     | some (c, kanon__n1, _) =>
                     (match (asBitVec kanon__n1) with
                       | some _ =>
                       some (c.unsigned)
                       | _ => none)
                     | _ => none),
        (match (asAdd v) with
          | some (c, _, kanon__n1) =>
          (match (asBitVec kanon__n1) with
            | some _ =>
            some (c.unsigned)
            | _ => none)
          | _ => none),
        (match (asSub v) with
          | some (c, kanon__n1, _) =>
          (match (asBitVec kanon__n1) with
            | some _ =>
            some (c.unsigned)
            | _ => none)
          | _ => none),
        (match (asSub v) with
          | some (c, _, kanon__n1) =>
          (match (asBitVec kanon__n1) with
            | some _ =>
            some (c.unsigned)
            | _ => none)
          | _ => none),
        (match (asMul v) with
          | some (c, kanon__n1, _) =>
          (match (asBitVec kanon__n1) with
            | some _ =>
            some (c.unsigned)
            | _ => none)
          | _ => none),
        (match (asMul v) with
          | some (c, _, kanon__n1) =>
          (match (asBitVec kanon__n1) with
            | some _ =>
            some (c.unsigned)
            | _ => none)
          | _ => none)]).getD
        (match v with | _ => false))
  bitvec_const_keeps_in_range_eq : ∀ (signed : Bool) (n : Int) (l : Int) (r : Int), (bitvec_const_keeps_in_range signed n l r) =
      (let base := (bitvec_to_z signed n l);
      (let d := (base - (bitvec_to_z signed n r));
      ((decide ((bitvec_zmin (0 : Int) base) ≤ d)) && (decide (d ≤ (bitvec_zmax (0 : Int) base))))))
  bitvec_cancellable_eq : ∀ (signed : Bool) (a : S.Term), (bitvec_cancellable signed a) =
      (if signed
      then ((firstSome [(match (asBitVec a) with
                          | some z =>
                          some ((decide ((bitvec_to_z true (bitvec_size a) z) > (0 : Int))))
                          | _ => none)]).getD
             (match a with | _ => false))
      else (LBool.bool_sure_neq a (bitvec_bv_zero (bitvec_size a))))

