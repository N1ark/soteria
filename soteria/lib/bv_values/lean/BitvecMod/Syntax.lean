  bitvec_lit_add_overflows_eq : ∀ (signed : Bool) (s : S.Ty) (kanon__3 : S.Ty) (l : Int) (r : Int), (bitvec_lit_add_overflows signed s kanon__3 l r) =
      (let n := (bitvec_size_of_ty s);
