  bitvec_zmin_eq : ∀ (a : Int) (b : Int), (bitvec_zmin a b) =
      (if (decide (a ≤ b)) then a else b)
  bitvec_zmax_eq : ∀ (a : Int) (b : Int), (bitvec_zmax a b) =
      (if (decide (a ≥ b)) then a else b)
  bitvec_unchecked_eq : bitvec_unchecked =
      ({ signed := false, unsigned := false } : CoreMod.Checked)
  bitvec_checked_both_eq : bitvec_checked_both =
      ({ signed := true, unsigned := true } : CoreMod.Checked)
  bitvec_checked_signed_eq : bitvec_checked_signed =
      ({ signed := true, unsigned := false } : CoreMod.Checked)
  bitvec_checked_unsigned_eq : bitvec_checked_unsigned =
      ({ signed := false, unsigned := true } : CoreMod.Checked)
  bitvec_checked_of_signed_eq : ∀ (signed : Bool), (bitvec_checked_of_signed signed) =
      (if signed then bitvec_checked_signed else bitvec_checked_unsigned)
  bitvec_checked_has_eq : ∀ (signed : Bool) (c : CoreMod.Checked), (bitvec_checked_has signed c) =
      (if signed then c.signed else c.unsigned)
  bitvec_is_checked_eq : ∀ (c : CoreMod.Checked), (bitvec_is_checked c) =
      (c.signed || c.unsigned)
  bitvec_checked_meet_eq : ∀ (a : CoreMod.Checked) (b : CoreMod.Checked), (bitvec_checked_meet a b) =
      ({ signed := (a.signed && b.signed), unsigned := (a.unsigned && b.unsigned) } : CoreMod.Checked)
  bitvec_to_z_eq : ∀ (signed : Bool) (bits : Int) (z : Int), (bitvec_to_z signed bits z) =
      (if signed then (bitvec_signed_extract z (0 : Int) bits) else z)
  bitvec_max_for_eq : ∀ (signed : Bool) (n : Int), (bitvec_max_for signed n) =
      (let n := (if signed then (n - (1 : Int)) else n);
      ((bitvec_z_lsl (1 : Int) n) - (1 : Int)))
  bitvec_min_for_eq : ∀ (signed : Bool) (n : Int), (bitvec_min_for signed n) =
      (if signed
      then (- (bitvec_z_lsl (1 : Int) (n - (1 : Int))))
      else (0 : Int))
  bitvec_is_right_mask_eq : ∀ (z : Int), (bitvec_is_right_mask z) =
      ((decide (z > (0 : Int))) && (decide ((bitvec_popcount (z + (1 : Int))) = (1 : Int))))
  bitvec_right_mask_size_eq : ∀ (z : Int), (bitvec_right_mask_size z) =
      (bitvec_log2 (z + (1 : Int)))
  bitvec_covers_bitwidth_eq : ∀ (bits : Int) (z : Int), (bitvec_covers_bitwidth bits z) =
      ((bitvec_is_right_mask z) && (decide ((bitvec_right_mask_size z) = bits)))
  bitvec_is_pow2_eq : ∀ (z : Int), (bitvec_is_pow2 z) =
      ((decide (z > (0 : Int))) && (decide ((bitvec_popcount z) = (1 : Int))))
  bitvec_lsb_eq : ∀ (z : Int), (bitvec_lsb z) =
      (if (decide (z = (0 : Int)))
      then (128 : Int)
      else (bitvec_log2 (bitvec_z_land z (- z))))
  bitvec_msb_of_eq : ∀ (v : S.Term), (bitvec_msb_of v) =
      ((firstSome [(match (asBitVec v) with
                     | some z =>
                     (if (decide (z > (0 : Int)))
                     then some ((bitvec_log2 z))
                     else none)
                     | _ => none),
        (match (asBitVec v) with
          | some kanon__1 =>
          (if (decide (kanon__1 = (0 : Int)))
          then some (((bitvec_size v) - (1 : Int)))
          else none)
          | _ => none),
        (match (asBitAnd v) with
          | some (bv1, bv2) =>
          some ((bitvec_zmin (bitvec_msb_of bv1) (bitvec_msb_of bv2)))
          | _ => none),
        (match (LBool.asIte v) with
          | some (_, l, r) =>
          some ((bitvec_zmax (bitvec_msb_of l) (bitvec_msb_of r)))
          | _ => none),
        (match (asBvExtend v) with
          | some (false, _, v) =>
          some ((bitvec_msb_of v))
          | _ => none),
        (match (asRem v) with
          | some (false, _, kanon__n1) =>
          (match (asBitVec kanon__n1) with
            | some k =>
            (if (decide (k > (1 : Int)))
            then some ((bitvec_log2 (k - (1 : Int))))
            else none)
            | _ => none)
          | _ => none),
        (match (asMod v) with
          | some (_, kanon__n1) =>
          (match (asBitVec kanon__n1) with
            | some k =>
            (if ((decide (k > (1 : Int))) && (decide (k < (bitvec_z_lsl (1 : Int) ((bitvec_size v) - (1 : Int))))))
            then some ((bitvec_log2 (k - (1 : Int))))
            else none)
            | _ => none)
          | _ => none),
        (match (asRem v) with
          | some (true, kanon__n1, _) =>
          (match (asBitVec kanon__n1) with
            | some k =>
            (if ((decide (k > (0 : Int))) && (decide (k < (bitvec_z_lsl (1 : Int) ((bitvec_size v) - (1 : Int))))))
            then some ((bitvec_log2 k))
            else none)
            | _ => none)
          | _ => none)]).getD
        (match v with | _ => ((bitvec_size v) - (1 : Int))))
  bitvec_overflows_add_eq : ∀ (signed : Bool) (n : Int) (l : Int) (r : Int), (bitvec_overflows_add signed n l r) =
      (let res := ((bitvec_to_z signed n l) + (bitvec_to_z signed n r));
      ((decide (res < (bitvec_min_for signed n))) || (decide (res > (bitvec_max_for signed n)))))
  bitvec_overflows_sub_eq : ∀ (signed : Bool) (n : Int) (l : Int) (r : Int), (bitvec_overflows_sub signed n l r) =
