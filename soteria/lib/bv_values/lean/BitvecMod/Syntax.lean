  bitvec_size_eq : ∀ (v : S.Term), (bitvec_size v) =
      (bitvec_size_of_ty (S.ty v))
  bitvec_is_bv_eq : ∀ (t : S.Ty), (bitvec_is_bv t) =
      ((firstSome [(match (asTBitVector t) with
                     | some _ =>
                     some (true)
                     | _ => none)]).getD
