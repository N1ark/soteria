def Float.round.r_lit (O : Ops S) (rm : CoreMod.Rm) (sv : S.Term) : Option S.Term :=
  (match (FloatMod.proj sv) with
    | some (.Float f) =>
    (whenSome true
    ((let kanon__a1 := (O.float_f_round rm f);
     (FloatMod.mk (.Float kanon__a1) (FloatMod.sort (.TFloat (FloatMod.f_prec kanon__a1)))))))
    | _ => none)

def Float.round.r_default (O : Ops S) (rm : CoreMod.Rm) (sv : S.Term) : Option S.Term :=
  (match sv with
    | _ =>
    (whenSome true ((FloatMod.mk (.FRound rm sv) (S.ty sv)))))

def Float.of_float.r_lit (O : Ops S) (rounding : CoreMod.Rm) (signed : Bool) (sz : Int) (v : S.Term) : Option S.Term :=
  (match (FloatMod.proj v) with
    | some (.Float f) =>
    (whenSome true
    (((firstSome [(match (O.float_f_to_int rounding signed sz f) with
                    | (some z) =>
                    (whenSome true ((BitvecMod.mk_masked sz z)))
                    | _ => none),
       (match (O.float_f_to_int rounding signed sz f) with
         | none =>
         (whenSome true
         ((FloatMod.mk (.BvOfFloat rounding signed sz v) (BitvecMod.sort (.TBitVector sz)))))
         | _ => none)]).getD
       Inhabited.default)))
    | _ => none)

def Float.of_float.r_default (O : Ops S) (rounding : CoreMod.Rm) (signed : Bool) (sz : Int) (v : S.Term) : Option S.Term :=
  (match v with
    | _ =>
    (whenSome true
    ((FloatMod.mk (.BvOfFloat rounding signed sz v) (BitvecMod.sort (.TBitVector sz))))))

def Float.to_float.r_lit (O : Ops S) (rounding : CoreMod.Rm) (signed : Bool) (fp : CoreMod.Fp) (v : S.Term) : Option S.Term :=
  (match (BitvecMod.proj v) with
    | some (.BitVec z) =>
    (whenSome true
    (((firstSome [(match (O.float_f_of_int rounding signed fp (BitvecMod.Bitvec.size v) z) with
                    | (some f) =>
                    (whenSome true
                    ((FloatMod.mk (.Float f) (FloatMod.sort (.TFloat (FloatMod.f_prec f))))))
                    | _ => none),
       (match (O.float_f_of_int rounding signed fp (BitvecMod.Bitvec.size v) z) with
         | none =>
         (whenSome true
         ((FloatMod.mk (.FloatOfBv rounding signed fp v) (FloatMod.sort (.TFloat fp)))))
         | _ => none)]).getD
       Inhabited.default)))
    | _ => none)

def Float.to_float.r_default (O : Ops S) (rounding : CoreMod.Rm) (signed : Bool) (fp : CoreMod.Fp) (v : S.Term) : Option S.Term :=
  (match v with
    | _ =>
    (whenSome true
    ((FloatMod.mk (.FloatOfBv rounding signed fp v) (FloatMod.sort (.TFloat fp))))))

def Float.to_float_bits.r_lit (O : Ops S) (fp : CoreMod.Fp) (v : S.Term) : Option S.Term :=
  (match (BitvecMod.proj v) with
    | some (.BitVec z) =>
    (whenSome true
    ((let kanon__a1 := (FloatMod.f_of_bits fp z);
     (FloatMod.mk (.Float kanon__a1) (FloatMod.sort (.TFloat (FloatMod.f_prec kanon__a1)))))))
    | _ => none)

def Float.to_float_bits.r_default (O : Ops S) (fp : CoreMod.Fp) (v : S.Term) : Option S.Term :=
  (match v with
    | _ =>
    (whenSome true
    ((FloatMod.mk (.FloatOfBvRaw fp v) (FloatMod.sort (.TFloat fp))))))

/-- What the proofs assume of the model: its rule functions refine their specs, its oracles
and extensible helpers do what they are assumed to do. -/
structure Ops.Sound (O : Ops S) : Prop extends toBitvecSound : BitvecMod.Ops.Sound O.toBitvecOps where
  float_is_floatclass : ∀ (fc : CoreMod.Fc) (sv : S.Term), S.Refines (Float.is_floatclass.spec fc sv) (O.float_is_floatclass fc sv)
  float_is_negative : ∀ (v : S.Term), S.Refines (Float.is_negative.spec v) (O.float_is_negative v)
  float_is_positive : ∀ (v : S.Term), S.Refines (Float.is_positive.spec v) (O.float_is_positive v)
  float_cast : ∀ (rounding : CoreMod.Rm) (fp : CoreMod.Fp) (v : S.Term), S.Refines (Float.cast.spec rounding fp v) (O.float_cast rounding fp v)
  float_eq : ∀ (v1 : S.Term) (v2 : S.Term), S.Refines (Float.eq.spec v1 v2) (O.float_eq v1 v2)
  float_lt : ∀ (v1 : S.Term) (v2 : S.Term), S.Refines (Float.lt.spec v1 v2) (O.float_lt v1 v2)
  float_leq : ∀ (v1 : S.Term) (v2 : S.Term), S.Refines (Float.leq.spec v1 v2) (O.float_leq v1 v2)
  float_add : ∀ (v1 : S.Term) (v2 : S.Term), S.Refines (Float.add.spec v1 v2) (O.float_add v1 v2)
  float_sub : ∀ (v1 : S.Term) (v2 : S.Term), S.Refines (Float.sub.spec v1 v2) (O.float_sub v1 v2)
  float_div : ∀ (v1 : S.Term) (v2 : S.Term), S.Refines (Float.div.spec v1 v2) (O.float_div v1 v2)
  float_mul : ∀ (v1 : S.Term) (v2 : S.Term), S.Refines (Float.mul.spec v1 v2) (O.float_mul v1 v2)
  float_rem : ∀ (v1 : S.Term) (v2 : S.Term), S.Refines (Float.rem.spec v1 v2) (O.float_rem v1 v2)
  float_abs : ∀ (v : S.Term), S.Refines (Float.abs.spec v) (O.float_abs v)
  float_neg : ∀ (v : S.Term), S.Refines (Float.neg.spec v) (O.float_neg v)
  float_fma : ∀ (a : S.Term) (b : S.Term) (c : S.Term), S.Refines (Float.fma.spec a b c) (O.float_fma a b c)
  float_fmod_of_rem : ∀ (r : S.Term) (v1 : S.Term) (v2 : S.Term), S.Refines (Float.fmod_of_rem.spec r v1 v2) (O.float_fmod_of_rem r v1 v2)
  float_fmod : ∀ (v1 : S.Term) (v2 : S.Term), S.Refines (Float.fmod.spec v1 v2) (O.float_fmod v1 v2)
  float_min : ∀ (v1 : S.Term) (v2 : S.Term), S.Refines (Float.min.spec v1 v2) (O.float_min v1 v2)
  float_max : ∀ (v1 : S.Term) (v2 : S.Term), S.Refines (Float.max.spec v1 v2) (O.float_max v1 v2)
  float_sqrt : ∀ (v : S.Term), S.Refines (Float.sqrt.spec v) (O.float_sqrt v)
  float_round : ∀ (rm : CoreMod.Rm) (sv : S.Term), S.Refines (Float.round.spec rm sv) (O.float_round rm sv)
  float_of_float : ∀ (rounding : CoreMod.Rm) (signed : Bool) (sz : Int) (v : S.Term), S.Refines (Float.of_float.spec rounding signed sz v) (O.float_of_float rounding signed sz v)
  float_to_float : ∀ (rounding : CoreMod.Rm) (signed : Bool) (fp : CoreMod.Fp) (v : S.Term), S.Refines (Float.to_float.spec rounding signed fp v) (O.float_to_float rounding signed fp v)
  float_to_float_bits : ∀ (fp : CoreMod.Fp) (v : S.Term), S.Refines (Float.to_float_bits.spec fp v) (O.float_to_float_bits fp v)
  float_orc : Oracle.Compat (S := S) O.float_f_add O.float_f_sub O.float_f_mul O.float_f_div O.float_f_rem O.float_f_fmod O.float_f_min O.float_f_max O.float_f_fma O.float_f_sqrt O.float_f_round O.float_f_convert O.float_f_to_int O.float_f_of_int

end FloatMod
