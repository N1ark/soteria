  float_raw_fmod_of_rem_eq : ∀ (r : S.Term) (v1 : S.Term) (v2 : S.Term), (float_raw_fmod_of_rem r v1 v2) =
      (let is_neg := fun (v : S.Term) =>
        (B.node (FIsNegK v) LBool.TBool);
      (let abs2 := (B.node (FAbsK v2) (S.ty v2));
      (let correction := (B.node (LBool.IteK (is_neg v1) (B.node (FNegK abs2) (S.ty abs2)) abs2) (S.ty abs2));
