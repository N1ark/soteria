/-- The terms of the language: the nodes of its modules, at a sort. -/
inductive Term where
  | bool (n : KanonBool.Node Term) (t : Ty)
  | core (n : CoreMod.Node Term) (t : Ty)
  | bitvec (n : BitvecMod.Node Term) (t : Ty)
  | exists (n : (ExistsMod.Node Ty) Term) (t : Ty)
  | float (n : FloatMod.Node Term) (t : Ty)
  | ptr (n : PtrMod.Node Term) (t : Ty)

/-- The sort of a term. -/
def Term.ty : Term → Ty
