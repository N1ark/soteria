;  The Lean types of the language, and the model, statements and assembly proof
;  of the rules, are generated from the declaration of the language and the
;  rules (rules/). `dune test` checks that the committed files are up to date:
;  run `kanon lean-all . ../rules/lang.knl` in lean/ after changing the rules.
;  CI checks their proofs with `lake build`.

(rule
 (alias runtest)
 (deps
  (source_tree .)
  (source_tree ../CoreMod)
  (source_tree ../ExistsMod)
  (source_tree ../BitvecMod)
  (source_tree ../FloatMod)
  (source_tree ../PtrMod)
  (glob_files %{project_root}/soteria/lib/bv_values/rules/*.{kn,knl}))
 (action
  (run
   %{bin:kanon}
   lean-all
   --check
   ..
   %{project_root}/soteria/lib/bv_values/rules/lang.knl)))
