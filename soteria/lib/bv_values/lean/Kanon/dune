; The Lean types of the language, and the model, statements and assembly proof
; of the rules, are generated from the declaration of the language and the
; rules.
;
; FROZEN: the Lean project is not ported to the new language of the C tool
; (rules/, generated by the Kanon that soteria pins), whose hand-written proofs
; and Lean library are still those of the old Kanon (see KANON_LEAN_COMMIT_HASH
; in scripts/versions.json): the proofs do not cover the rules of rules/. The
; committed Lean files are the output of the OLD Kanon on legacy_rules/ (old
; syntax, which the pinned Kanon does not read), so they are not checked by
; `dune test`. To check that they are up to date, with the old Kanon (commit
; KANON_LEAN_COMMIT_HASH) first in PATH:
;
;   dune build @soteria/lib/bv_values/lean/Kanon/lean-legacy
;
; CI checks them with `lake build`.

(rule
 (alias lean-legacy)
 (deps
  Types.lean
  Syntax.lean
  Signatures.lean
  Typing.lean
  Model.lean
  Statements.lean
  Lifts.lean
  Soundness.lean
  (glob_files %{project_root}/soteria/lib/bv_values/legacy_rules/*.{kn,knl}))
 (action
  (progn
   (run mkdir -p legacy)
   (chdir
    legacy
    (run
     %{bin:kanon}
     lean-all
     %{project_root}/soteria/lib/bv_values/legacy_rules/lang.knl))
   (system
    "for f in Types Syntax Signatures Typing Model Statements Lifts Soundness; do diff -u $f.lean legacy/$f.lean.gen || exit 1; done"))))
