(* The exists module: existential quantification over terms. *)

(* The binders of [binders] that occur free in the body. *)
prim used_binders : (var * ty) list -> t -> (var * ty) list

fn no_binders (l : (var * ty) list) : bool =
  match l with [] -> true | _ -> false

rule b_mk_exists : Exists (binders, (body : TBool)) =
  | empty: _ when no_binders (used_binders binders body) -> body
  | default: _ -> Exists (used_binders binders body, body)
