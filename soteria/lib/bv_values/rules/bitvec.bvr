(* Bit-vectors: conversions, arithmetic and bitwise operations *)

let[@spec BvOfBool (n, b) <| TBitVector n] bv_of_bool (n : int) (b : t) : t =
  match b with
  | true [@r true_] -> bv_one n
  | false [@r false_] -> bv_zero n
  | _ [@r default] -> BvOfBool (n, b) <| TBitVector n

let[@spec Not (Eq (v, bv_zero (size v)) <| TBool) <| TBool] bv_to_bool (v : t) :
    t =
  match v with
  | BitVec z [@r lit] -> of_bool (not (z = 0))
  | BvOfBool (_, b) [@r of_bool] -> b
  | _ [@r default] -> b_not (sem_eq v (bv_zero (size v)))

let[@spec
     BvOfBool (size v, Eq (v, bv_zero (size v)) <| TBool) <| TBitVector (size v)]
    bv_not_bool (v : t) : t =
  let n = size v in
  match v with
  | BitVec z [@r lit] -> if z = 0 then bv_one n else bv_zero n
  | BvOfBool (n, g) [@r of_bool] -> bv_of_bool n (b_not g)
  | _ [@r default] -> bv_of_bool n (sem_eq v (bv_zero n))

let[@spec Add (checked, v1, v2) <| ty v1] bv_add (checked : checked) (v1 : t)
    (v2 : t) : t =
  assert (ty v1 = ty v2);
  match (v1, v2) with
  | BitVec l, BitVec r [@r lits] -> mk_masked (size v1) (l + r)
  | Neg (_, v1), _ [@r neg_l] -> bv_sub unchecked v2 v1
  | _, Neg (_, v2) [@r neg_r] -> bv_sub unchecked v1 v2
  | _, 0 [@r zero_r] -> v1
  | 0, _ [@r zero_l] -> v2
  (* ~v + 1 = -v *)
  | (1, BvNot v) [@comm] [@r not_one] -> bv_neg false v
  (* (c1 + r) + c2 = (c1 + c2) + r *)
  | Add (c, (BitVec _ as c1), r) [@comm], BitVec _ [@r add_const] ->
      let checked =
        mask_checked_after_fold (checked_meet checked c) c1 v2 true
      in
      bv_add checked (bv_add unchecked c1 v2) r
  (* (l - c1) + c2 = l + (c2 - c1) *)
  | Sub (c, l, (BitVec _ as c1)), BitVec _ [@r sub_const_r] ->
      let checked =
        mask_checked_after_fold (checked_meet checked c) v2 c1 false
      in
      bv_add checked l (bv_sub unchecked v2 c1)
  (* (c1 - r) + c2 = (c1 + c2) - r *)
  | Sub (c, (BitVec _ as c1), r), BitVec _ [@r sub_const_l] ->
      let checked =
        mask_checked_after_fold (checked_meet checked c) c1 v2 true
      in
      bv_sub checked (bv_add unchecked c1 v2) r
  (* r + (l - r) = l *)
  | r, Sub (_, l, r) [@r sub_cancel_r] -> l
  | Sub (_, l, r), r [@r sub_cancel_l] -> l
  (* (a + b) + (c - a) = b + c (holds modulo 2^n) *)
  | (Add (_, a, b) [@comm], Sub (_, c, a)) [@comm] [@r add_sub] ->
      bv_add unchecked b c
  (* a * b + a * c = a * (b + c) *)
  | Mul (_, a, b) [@comm], Mul (_, a, c) [@comm] [@r factor] ->
      bv_mul unchecked a (bv_add unchecked b c)
  | ( Mul (ck1, (BitVec l1 as v_l1), r1) [@comm],
      Mul (ck2, (BitVec l2 as v_l2), r2) [@comm] ) [@r factor_const]
    when (checked_meet (checked_meet checked ck1) ck2).unsigned
         && (divisible l1 l2 || divisible l2 l1) ->
      let checked = checked_unsigned in
      if divisible l2 l1 then
        let common = mk_bv (size v1) (tdiv l2 l1) in
        bv_mul checked v_l1 (bv_add checked r1 (bv_mul checked common r2))
      else
        let common = mk_bv (size v1) (tdiv l1 l2) in
        bv_mul checked v_l2 (bv_add checked r2 (bv_mul checked common r1))
  (* only propagate down ites if we know it's concrete *)
  | (Ite (b, l, r), BitVec x) [@comm] [@r ite] ->
      let x = mk_bv (size v1) x in
      b_ite b (bv_add checked l x) (bv_add checked r x)
  | _ [@r default] -> mk_commut_binop (Add checked) v1 v2 <| ty v1

let[@spec Sub (checked, v1, v2) <| ty v1] bv_sub (checked : checked) (v1 : t)
    (v2 : t) : t =
  match (v1, v2) with
  | BitVec l, BitVec r [@r lits] -> mk_masked (size v1) (l - r)
  | _, 0 [@r zero_r] -> v1
  | 0, _ [@r zero_l] ->
      (* 0 - x = -x; the subtraction overflows (signed) iff x = INT_MIN, so a
         signed-checked subtraction yields a signed-checked negation. *)
      bv_neg checked.signed v2
  | v, v [@r same] -> bv_zero (size v1)
  | _, Neg (_, v2) [@r neg_r] -> bv_add unchecked v1 v2
  (* (c1 - s) - c2 = (c1 - c2) - s *)
  | Sub (c, (BitVec _ as c1), s), BitVec _ [@r sub_const_l] ->
      let checked =
        mask_checked_after_fold (checked_meet c checked) c1 v2 false
      in
      bv_sub checked (bv_sub unchecked c1 v2) s
  (* (s - c1) - c2 = s - (c1 + c2) *)
  | Sub (c, s, (BitVec _ as c1)), BitVec _ [@r sub_const_r] ->
      let checked =
        mask_checked_after_fold (checked_meet c checked) c1 v2 true
      in
      bv_sub checked s (bv_add unchecked c1 v2)
  (* c1 - (r + l) = (c1 - r) - l *)
  | BitVec _, Add (c, (BitVec _ as r), l) [@comm] [@r const_add] ->
      let checked =
        mask_checked_after_fold (checked_meet c checked) v1 r false
      in
      bv_sub checked (bv_sub unchecked v1 r) l
  (* (l + c1) - c2 = l + (c1 - c2) *)
  | Add (c, (BitVec bv1 as r), l) [@comm], BitVec bv2 [@r add_const] ->
      (* if bv1 < bv2 there would be an overflow which causes problems since the
         operation can't be deemed checked anymore. *)
      if bv1 < bv2 then
        let checked =
          mask_checked_after_fold (checked_meet c checked) v2 r false
        in
        bv_sub checked l (bv_neg false (bv_sub unchecked r v2))
      else
        let checked =
          mask_checked_after_fold (checked_meet c checked) r v2 false
        in
        bv_add checked l (bv_sub unchecked r v2)
  (* (l + r) - l = r *)
  | Add (_, l, r), l [@r add_cancel_l] -> r
  | Add (_, l, r), r [@r add_cancel_r] -> l
  (* (l + r1) - (l + r2) = r1 - r2 *)
  | Add (_, l, r1), Add (_, l, r2) [@r add_add] -> bv_sub unchecked r1 r2
  (* l - (l - r) = r *)
  | l, Sub (_, l, r) [@r sub_sub] -> r
  (* distributing over a shared guard lets the branches cancel pairwise *)
  | Ite (b, l, r), Ite (b, l', r') [@r ite_ite] ->
      b_ite b (bv_sub unchecked l l') (bv_sub unchecked r r')
  (* only propagate down ites if we know it's concrete *)
  | Ite (b, l, r), BitVec _ [@r ite_l] ->
      b_ite b (bv_sub unchecked l v2) (bv_sub unchecked r v2)
  | BitVec _, Ite (b, l, r) [@r ite_r] ->
      b_ite b (bv_sub unchecked v1 l) (bv_sub unchecked v1 r)
  | BvOfBool (n, b), BitVec _ [@r of_bool_l] ->
      b_ite b (bv_sub unchecked (bv_one n) v2) (bv_neg false v2)
  | BitVec _, BvOfBool (n, b) [@r of_bool_r] ->
      b_ite b (bv_sub unchecked v1 (bv_one n)) v1
  | _ [@r default] -> Sub (checked, v1, v2) <| ty v1

let[@spec Neg (checked, v) <| ty v] bv_neg (checked : bool) (v : t) : t =
  let n = size v in
  match v with
  | BitVec bv [@r lit] -> mk_masked n (-bv)
  | Neg (_, v) [@r neg] -> v
  | Ite (b, l, r) [@r ite] -> b_ite b (bv_neg checked l) (bv_neg checked r)
  | BvOfBool (n, b) [@r of_bool] ->
      b_ite b (bv_neg false (bv_one n)) (bv_zero n)
  | _ [@r default] -> Neg (checked, v) <| ty v

(* the signed remainder of [v1 / v2], which takes the sign of the divisor
   [v2] *)
let[@spec Mod (v1, v2) <| ty v1] bv_mod (v1 : t) (v2 : t) : t =
  match (v1, v2) with
  | BitVec l, BitVec r [@r lits] ->
      let sz = size v1 in
      let l = bv_to_z true sz l in
      let r = bv_to_z true sz r in
      let res = trem l r in
      let res =
        if res < 0 && not (r < 0) then res + r
        else if res > 0 && r < 0 then res + r
        else res
      in
      mk_masked sz res
  | _ [@r default] -> Mod (v1, v2) <| ty v1

(* the remainder of [v1 / v2], which takes the sign of the dividend [v1] if
   [signed] *)
let[@spec Rem (signed, v1, v2) <| ty v1] bv_rem (signed : bool) (v1 : t)
    (v2 : t) : t =
  match (v1, v2) with
  | BitVec l, BitVec r [@r lits] ->
      let sz = size v1 in
      let l = bv_to_z signed sz l in
      let r = bv_to_z signed sz r in
      mk_masked sz (trem l r)
  | 0, _ [@r zero_l] -> bv_zero (size v1)
  | _, 1 [@r one_r] when not signed -> bv_zero (size v1)
  (* x %u 2^k keeps the k lowest bits of x *)
  | _, BitVec r [@r pow2] when (not signed) && is_pow2 r && r > 1 ->
      let sz = size v1 in
      let bitwidth = log2 r in
      let lower = bv_extract 0 (bitwidth - 1) v1 in
      bv_extend false (sz - bitwidth) lower
  (* (d + r) %u d = r %u d, when the addition does not wrap *)
  | Add (ck, BitVec d, r) [@comm], BitVec d [@r add]
    when (not signed) && ck.unsigned ->
      bv_rem signed r v2
  | Rem (false, r, (BitVec r1 as v_r1)), BitVec r2 [@r rem_rem]
    when (not signed) && r1 > 0 && r2 > 0
         && (0 = trem r1 r2 || 0 = trem r2 r1) ->
      let rhs = if zmin r1 r2 = r1 then v_r1 else v2 in
      bv_rem signed r rhs
  | _ [@r default] -> Rem (signed, v1, v2) <| ty v1

let[@spec BvNot v <| ty v] bv_not (v : t) : t =
  match v with
  | BitVec bv [@r lit] -> mk_masked (size v) (lognot bv)
  | Ite (b, l, r) [@r ite] -> b_ite b (bv_not l) (bv_not r)
  | _ [@r default] -> BvNot v <| ty v

let[@spec BitAnd (v1, v2) <| TBitVector (size v1)] bv_and (v1 : t) (v2 : t) : t
    =
  let n = size v1 in
  assert (n = size v2);
  match (v1, v2) with
  | BitVec l, BitVec r [@r lits] -> mk_bv n (l land r)
  | 0, _ [@r zero_l] -> v1
  | _, 0 [@r zero_r] -> v2
  | BitVec mask, _ [@r ones_l] when covers_bitwidth n mask -> v2
  | _, BitVec mask [@r ones_r] when covers_bitwidth n mask -> v1
  (* For (x >> s) & m, the mask is irrelevant if it entirely covers [bitsize -
     s] *)
  | ((LShr (_, BitVec shift) as base), BitVec mask) [@comm] [@r lshr_mask]
    when shift >= 0 && shift < n
         &&
         let bitwidth = n - shift in
         let low_mask = (1 lsl bitwidth) - 1 in
         mask land low_mask = low_mask ->
      kind base <| TBitVector n
  | BitVec _, Ite (b, l, r) [@r ite_r] -> b_ite b (bv_and v1 l) (bv_and v1 r)
  | Ite (b, l, r), BitVec _ [@r ite_l] -> b_ite b (bv_and l v2) (bv_and r v2)
  (* m1 & (x & m2) = x & (m1 & m2) *)
  | (BitVec m1, BitAnd (x, BitVec m2) [@comm]) [@comm] [@r masks] ->
      bv_and x (mk_bv n (m1 land m2))
  (* collapse M & (N | (P & X)) into (M & N) | (M & P & X) where M, N and P
     concrete *)
  | ( (BitVec _ as m),
      BitOr ((BitVec _ as n), BitAnd ((BitVec _ as p), x) [@comm]) [@comm] )
    [@comm] [@r mask_or_mask] ->
      let vty = ty v1 in
      let m = kind m <| vty in
      bv_or (bv_and m n) (bv_and x (bv_and m p))
  (* M & (N | X) *)
  | (BitVec m_and, BitOr (x, BitVec m_or) [@comm]) [@comm] [@r mask_or] ->
      let overlap = m_and land m_or in
      if overlap = m_and then
        (* M & (N | X) when M & N == M ==> M (all bits already set by the
           or) *)
        mk_bv n m_and
      else if overlap = 0 then
        (* M & (N | X) when M & N == 0 ==> M & X (no bits set by the or) *)
        bv_and x (mk_bv n m_and)
      else (* give up *)
        mk_commut_binop BitAnd v1 v2 <| TBitVector n
  (* if it's a right mask, it's usually beneficial to propagate it *)
  | (BitVec mask, BitAnd (l, r)) [@comm] [@r right_mask]
    when is_right_mask mask ->
      let mask = mk_bv (size v1) mask in
      bv_and (bv_and mask l) (bv_and mask r)
  | 1, BvOfBool _ [@r of_bool_r] -> v2
  | BvOfBool _, 1 [@r of_bool_l] -> v1
  | BvOfBool (_, b1), BvOfBool (_, b2) [@r of_bools] ->
      bv_of_bool n (b_and b1 b2)
  | Ite (b1, l1, 0), Ite (b2, l2, 0) [@r ites] ->
      b_ite (b_and b1 b2) (bv_and l1 l2) (bv_zero (size v1))
  | _ [@r default] -> mk_commut_binop BitAnd v1 v2 <| TBitVector n

let[@spec BitOr (v1, v2) <| ty v1] bv_or (v1 : t) (v2 : t) : t =
  assert (is_bv (ty v1) && is_bv (ty v2));
  match (v1, v2) with
  | BitVec l, BitVec r [@r lits] -> mk_bv (size v1) (l lor r)
  | 0, _ [@r zero_l] -> v2
  | _, 0 [@r zero_r] -> v1
  | v, v [@r same] -> v1
  (* m1 | (x & m2) where m2 is a subset of m1's bits means the & is
     redundant *)
  | (BitVec m1, BitAnd (_, BitVec m2) [@comm]) [@comm] [@r mask_and]
    when m1 land m2 = m2 ->
      mk_bv (size v1) m1
  (* m1 | (x | m2) = x | (m1 | m2) *)
  | (BitVec m1, BitOr (x, BitVec m2) [@comm]) [@comm] [@r masks] ->
      bv_or x (mk_bv (size v1) (m1 lor m2))
  (* 0x0..0X..X | (0x0..0Y..Y << N) when N = |X..X| ==> 0x0..0Y..YX..X *)
  | ( BvExtend (false, nx, base),
      Shl (BvExtend (false, _, tail), BitVec shift) ) [@r extend_shl]
    when shift = size base && nx > 0 ->
      let tail_size = size tail in
      if nx = tail_size then bv_concat tail base
      else if nx > tail_size then
        let new_base = bv_concat tail base in
        bv_extend false (nx - tail_size) new_base
      else
        let new_tail = bv_extract 0 (nx - 1) tail in
        bv_concat new_tail base
  | BvOfBool (n, b1), BvOfBool (_, b2) [@r of_bools] ->
      bv_of_bool n (b_or b1 b2)
  | _ [@r default] -> mk_commut_binop BitOr v1 v2 <| ty v1

let[@spec BitXor (v1, v2) <| ty v1] bv_xor (v1 : t) (v2 : t) : t =
  match (v1, v2) with
  | BitVec l, BitVec r [@r lits] -> mk_bv (size v1) (l lxor r)
  | 0, _ [@r zero_l] -> v2
  | _, 0 [@r zero_r] -> v1
  | BvOfBool (n, b1), BvOfBool (_, b2) [@r of_bools] ->
      bv_of_bool n (b_not (sem_eq b1 b2))
  | _ [@r default] -> mk_commut_binop BitXor v1 v2 <| ty v1

(* [bv_extract from_ to_ v] covers the bits of [v] from index [from_] to index
   [to_], inclusive. [0 <= from_ <= to_ < size v] must hold. *)
let[@spec BvExtract (from_, to_, v) <| TBitVector (to_ - from_ + 1)] bv_extract
    (from_ : int) (to_ : int) (v : t) : t =
  let prev_size = size v in
  assert (0 <= from_ && from_ <= to_ && to_ < prev_size);
  let sz = to_ - from_ + 1 in
  match v with
  | BitVec bv [@r lit] -> mk_masked sz (bv asr from_)
  | _ [@r full] when from_ = 0 && to_ = prev_size - 1 -> v
  | BitAnd (v1, v2) [@r and_] ->
      bv_and (bv_extract from_ to_ v1) (bv_extract from_ to_ v2)
  | BitOr (v1, v2) [@r or_] ->
      bv_or (bv_extract from_ to_ v1) (bv_extract from_ to_ v2)
  | BitXor (v1, v2) [@r xor] ->
      bv_xor (bv_extract from_ to_ v1) (bv_extract from_ to_ v2)
  | Shl (v1, BitVec shift) [@r shl] ->
      if from_ >= shift then
        (* All extracted bits come from the original v1, shifted *)
        bv_extract (from_ - shift) (to_ - shift) v1
      else if to_ < shift then
        (* All extracted bits are zeros introduced by the shift *)
        bv_zero sz
      else
        (* Some bits are zeros, some are from v1: bits [from_, shift-1] are 0,
           bits [shift, to_] come from v1[0, to_-shift] *)
        let high_part = bv_extract 0 (to_ - shift) v1 in
        let low_zeros = bv_zero (shift - from_) in
        bv_concat high_part low_zeros
  | LShr (v1, BitVec shift) [@r lshr] ->
      (* after a right shift by [shift], bit i of the result is bit (i+shift)
         of the original if i+shift < prev_size, else 0 *)
      if from_ + shift >= prev_size then
        (* All extracted bits are zeros introduced by the shift *)
        bv_zero sz
      else if to_ + shift < prev_size then
        (* All extracted bits come from the original v1, shifted *)
        bv_extract (from_ + shift) (to_ + shift) v1
      else
        (* Some bits are from v1, some are zeros: bits [from_,
           prev_size-shift-1] come from v1[from_+shift, prev_size-1], bits
           [prev_size-shift, to_] are 0 *)
        let low_part = bv_extract (from_ + shift) (prev_size - 1) v1 in
        let high_zeros = bv_zero (to_ - (prev_size - shift - 1)) in
        bv_concat high_zeros low_part
  | Ite (b, l, r) [@r ite] ->
      b_ite b (bv_extract from_ to_ l) (bv_extract from_ to_ r)
  | BvExtend (false, by, _) [@r zext_high] when from_ >= prev_size - by ->
      (* zero extension, and we're extracting only the extended bits *)
      bv_zero sz
  | BvExtend (true, by, v) [@r sext_bit]
    when from_ >= prev_size - by && from_ = to_ ->
      (* sign extension, and we're extracting an extended bit: msb of the prev
         value *)
      bv_extract (size v - 1) (size v - 1) v
  | BvExtend (signed, _, v) [@r ext_low] when from_ = 0 ->
      (* extracting from the beginning of an extended value *)
      let orig_size = size v in
      if to_ = orig_size - 1 then (* extracting exactly the original bits *)
        v
      else if to_ < orig_size then
        (* extracting subset of original bits *)
        bv_extract from_ to_ v
      else (* we can reduce the extend *)
        bv_extend signed (to_ - orig_size + 1) v
  | BvExtend (_, by, v) [@r ext_orig] when to_ <= prev_size - by - 1 ->
      (* extracting from original bits *)
      bv_extract from_ to_ v
  | BvExtract (prev_from_, _, v) [@r extract] ->
      bv_extract (prev_from_ + from_) (prev_from_ + to_) v
  | BvConcat (l, r) [@r concat] ->
      let size_r = size r in
      if from_ >= size_r then bv_extract (from_ - size_r) (to_ - size_r) l
      else if to_ < size_r then bv_extract from_ to_ r
      else
        let r' = bv_extract from_ (size_r - 1) r in
        let l' = bv_extract 0 (to_ - size_r) l in
        bv_concat l' r'
  | Add (_, l, r) [@r add_low] when from_ = 0 ->
      bv_add unchecked (bv_extract from_ to_ l) (bv_extract from_ to_ r)
  (* adding a constant whose lowest set bit is above [to_] *)
  | Add (_, BitVec n, x) [@comm] [@r add_const] when to_ < lsb n ->
      bv_extract from_ to_ x
  | Mul (_, BitVec n, _) [@r mul_pow2] when is_pow2 n && to_ < log2 n ->
      bv_zero sz
  | Mul (_, l, r) [@r mul_low] when from_ = 0 ->
      (* i think the extraction is necessarily unchecked? *)
      bv_mul unchecked (bv_extract from_ to_ l) (bv_extract from_ to_ r)
  | Rem (false, l, BitVec n) [@r urem]
    when from_ = 0 && is_pow2 n && log2 n < to_ ->
      (* extract[0,N](X % 2^M) when M < N can be pushed down *)
      bv_rem false (bv_extract from_ to_ l) (mk_bv (to_ + 1) n)
  | _ [@r default] -> BvExtract (from_, to_, v) <| TBitVector sz

let[@spec BvExtend (signed, extend_by, v) <| TBitVector (size v + extend_by)]
    bv_extend (signed : bool) (extend_by : int) (v : t) : t =
  assert (is_bv (ty v));
  let n = size v in
  let to_ = n + extend_by in
  assert (extend_by > 0);
  match v with
  | BitVec bv [@r lit] ->
      if signed then (* Sign extend: replicate the MSB *)
        mk_masked to_ (signed_extract bv 0 n)
      else (* Zero extend: do nothing *)
        mk_bv to_ bv
  | BvExtend (s, prev_by, v) [@r extend] when s = signed ->
      (* combine extensions *)
      bv_extend signed (prev_by + extend_by) v
  | Ite (b, l, r) [@r ite] ->
      b_ite b (bv_extend signed extend_by l) (bv_extend signed extend_by r)
  (* can't extend if signed && n == 1, as it should be all 1s *)
  | BvOfBool (n, b) [@r of_bool] when (not signed) || n > 1 ->
      bv_of_bool to_ b
  | _ [@r default] -> BvExtend (signed, extend_by, v) <| TBitVector to_

(* [bv_concat v1 v2] for [v1] of size [n] and [v2] of size [m] is a bitvector
   of size [n + m] where the first [m] bits are [v2] and the following [n] are
   [v1] *)
let[@spec BvConcat (v1, v2) <| TBitVector (size v1 + size v2)] bv_concat
    (v1 : t) (v2 : t) : t =
  let n1 = size v1 in
  let n2 = size v2 in
  match (v1, v2) with
  | BitVec l, BitVec r [@r lits] -> mk_masked (n1 + n2) (r + (l lsl n2))
  | BvExtract (from1, to1, v), BvExtract (from2, to2, v) [@r extracts]
    when to2 + 1 = from1 ->
      bv_extract from2 to1 v
  (* safeguard: to avoid infinite loops, we keep bv-concats of extracts
     left-dominant *)
  | BvExtract _, BvConcat (BvExtract _, BvExtract _) [@r extract_extracts] ->
      BvConcat (v1, v2) <| TBitVector (n1 + n2)
  (* We re-order (extract A ++ (extract B ++ X)) to ((extract A ++ extract B)
     ++ X) *)
  | BvExtract (_, _, x), BvConcat ((BvExtract (_, _, x) as left), right)
    [@r assoc_l] ->
      bv_concat (bv_concat v1 left) right
  (* We re-order ((X ++ extract A) ++ extract B) to (X ++ (extract A ++ extract
     B)) *)
  | BvConcat (left, (BvExtract (_, _, x) as right)), BvExtract (_, _, x)
    [@r assoc_r] ->
      bv_concat left (bv_concat right v2)
  | Ite (b, l1, r1), Ite (b, l2, r2) [@r ites] ->
      b_ite b (bv_concat l1 l2) (bv_concat r1 r2)
  | _ [@r default] -> BvConcat (v1, v2) <| TBitVector (n1 + n2)

let[@spec Shl (v1, v2) <| ty v1] bv_shl (v1 : t) (v2 : t) : t =
  match (v1, v2) with
  | BitVec l, BitVec r [@r lits] -> mk_masked (size v1) (l lsl r)
  | _, 0 [@r zero] -> v1
  | _, BitVec s [@r big] when s >= size v1 -> bv_zero (size v1)
  | Shl (v, BitVec s1), BitVec s2 [@r shl] ->
      bv_shl v (mk_bv (size v1) (zmin (s1 + s2) (size v1)))
  | LShr (x, BitVec sr), BitVec sl [@r lshr] ->
      let n = size v1 in
      if sl <= sr then
        (* (x >> s1) << s2 where s2 < s1 = x >> (s1 - s2) & (mask with lower
           bits cleared) *)
        let mask = lognot ((1 lsl sl) - 1) in
        bv_and (bv_lshr x (mk_bv n (sr - sl))) (mk_masked n mask)
      else
        (* (x >> s1) << s2 where s2 > s1 = x << (s2 - s1) & (mask with lower
           bits cleared) *)
        let mask = lognot ((1 lsl sr) - 1) in
        bv_shl (bv_and x (mk_masked n mask)) (mk_bv n (sl - sr))
  (* (x & mask) << s = (x << s) & (mask << s) *)
  | BitAnd (x, BitVec mask) [@comm], BitVec s [@r and_mask] ->
      bv_and (bv_shl x v2) (mk_masked (size v1) (mask lsl s))
  (* (x | mask) << s = (x << s) | (mask << s) *)
  | BitOr (x, BitVec mask) [@comm], BitVec s [@r or_mask] ->
      bv_or (bv_shl x v2) (mk_masked (size v1) (mask lsl s))
  | _ [@r default] -> Shl (v1, v2) <| ty v1

let[@spec LShr (v1, v2) <| ty v1] bv_lshr (v1 : t) (v2 : t) : t =
  match (v1, v2) with
  | BitVec l, BitVec r [@r lits] -> mk_masked (size v1) (l asr r)
  | _, 0 [@r zero] -> v1
  | _, BitVec s [@r big] when s >= size v1 -> bv_zero (size v1)
  | LShr (v, BitVec s1), BitVec s2 [@r lshr] ->
      bv_lshr v (mk_bv (size v1) (zmin (s1 + s2) (size v1)))
  (* (x & mask) >> s = (x >> s) & (mask >> s) *)
  | BitAnd (x, BitVec mask) [@comm], BitVec s [@r and_mask] ->
      bv_and (bv_lshr x v2) (mk_bv (size v1) (mask asr s))
  (* (x | mask) >> s = (x >> s) | (mask >> s) *)
  | BitOr (x, BitVec mask) [@comm], BitVec s [@r or_mask] ->
      bv_or (bv_lshr x v2) (mk_bv (size v1) (mask asr s))
  | _ [@r default] -> LShr (v1, v2) <| ty v1

let[@spec AShr (v1, v2) <| ty v1] bv_ashr (v1 : t) (v2 : t) : t =
  let sz = size v1 in
  match (v1, v2) with
  | BitVec l, BitVec r [@r lits] ->
      mk_masked sz (signed_extract l 0 sz asr r)
  | _, 0 [@r zero] -> v1
  | _, BitVec s [@r big] when s >= sz -> bv_ashr v1 (mk_masked sz (sz - 1))
  | AShr (v, BitVec s1), BitVec s2 [@r ashr] ->
      bv_ashr v (mk_bv sz (zmin (s1 + s2) (sz - 1)))
  | _ [@r default] -> AShr (v1, v2) <| ty v1

let[@spec Mul (checked, v1, v2) <| ty v1] bv_mul (checked : checked) (v1 : t)
    (v2 : t) : t =
  assert (ty v1 = ty v2);
  match (v1, v2) with
  | BitVec l, BitVec r [@r lits] -> mk_masked (size v1) (l * r)
  | _, 1 [@r one_r] -> v1
  | 1, _ [@r one_l] -> v2
  | _, 0 [@r zero_r] -> bv_zero (size v1)
  | 0, _ [@r zero_l] -> bv_zero (size v1)
  (* c * (-x) = (-c) * x (holds mod 2^n); with a checked negation (x <>
     INT_MIN) and c <> INT_MIN, the signed no-overflow guarantee carries over
     to the rebuilt product. *)
  | (BitVec c, Neg (true, x)) [@comm] [@r neg]
    when not (bv_to_z true (size v1) c = min_for true (size v1)) ->
      bv_mul
        (checked_meet checked checked_signed)
        (bv_neg false (mk_bv (size v1) c))
        x
  (* (x * n) * m = x * (n * m) *)
  | (Mul (ckm, x, BitVec n) [@comm], BitVec m) [@comm] [@r mul_const]
    when is_checked (checked_meet checked ckm) ->
      let checked = checked_meet checked ckm in
      (* the signed check only carries over if [n * m] does not overflow *)
      let checked =
        if overflows_mul true (size v1) n m then
          checked_meet checked checked_unsigned
        else checked
      in
      bv_mul checked x (mk_masked (size v1) (n * m))
  (* only propagate down ites if we know it's concrete *)
  | (Ite (b, l, r), BitVec x) [@comm] [@r ite] ->
      let x = mk_bv (size v1) x in
      b_ite b (bv_mul unchecked l x) (bv_mul unchecked r x)
  | _ [@r default] -> mk_commut_binop (Mul checked) v1 v2 <| ty v1

let[@spec Div (signed, v1, v2) <| ty v1] bv_div (signed : bool) (v1 : t)
    (v2 : t) : t =
  assert (ty v1 = ty v2);
  match (v1, v2) with
  | BitVec l, BitVec r [@r lits] ->
      let sz = size v1 in
      let l = bv_to_z signed sz l in
      let r = bv_to_z signed sz r in
      (* division by zero gives all ones, or 1 for signed negative dividends *)
      if r = 0 then mk_masked sz (if signed && l < 0 then 1 else -1)
      else mk_masked sz (tdiv l r)
  | _, 1 [@r one] -> v1
  (* this case shouldn't happen but it avoids conflicts for the next two
     patterns *)
  | Mul (checked, (BitVec _ as l), (BitVec _ as r)), BitVec _ [@r mul_lits] ->
      bv_div signed (bv_mul checked l r) v2
  (* (x * n) / d = x * (n / d) when n % d == 0 *)
  | Mul ({ unsigned = true; _ }, BitVec n, x) [@comm], BitVec d [@r mul_div]
    when (not signed) && d <> 0 && divisible n d ->
      bv_mul checked_unsigned x (mk_bv (size v1) (tdiv n d))
  (* (x * n) / d = x / (d / n) when d % n == 0 *)
  | Mul ({ unsigned = true; _ }, BitVec n, x) [@comm], BitVec d [@r div_mul]
    when (not signed) && divisible d n ->
      bv_div signed x (mk_bv (size v1) (tdiv d n))
  (* (x /u n) /u d = x /u (n * d) (if n * d doesn't overflow); not for signed
     divisions, which wrap for INT_MIN / -1 *)
  | Div (false, x, BitVec n), BitVec d [@r div_div]
    when (not signed) && n <> 0 && not (overflows_mul false (size v1) n d) ->
      bv_div signed x (mk_bv (size v1) (n * d))
  (* extend[uN](X) / N when msb(N) < size(X) <=> extend[uN](X / N) *)
  | BvExtend (false, by, x), BitVec z [@r zext]
    when (not signed) && msb_of v2 < size x ->
      bv_extend false by (bv_div signed x (mk_bv (size x) z))
  | _ [@r default] -> Div (signed, v1, v2) <| ty v1

(* Whether [v] is an addition, subtraction or multiplication involving a
   constant that is known not to overflow when interpreted as unsigned. The
   unsigned [lt]/[leq] cases can reduce such operations, so a signed comparison
   against one is worth rewriting to unsigned. *)
let is_checked_unsigned_op (v : t) : bool =
  match v with
  | Add (c, BitVec _, _) [@comm]
  | Sub (c, BitVec _, _) [@comm]
  | Mul (c, BitVec _, _) [@comm] ->
      c.unsigned
  | _ -> false

(* An inclusive upper bound on the unsigned value of [v], derived from its most
   significant possibly-set bit (e.g. [x & 0b11 <= 3]). Conservative: an
   unknown value bounds to the full width's maximum. *)
let unsigned_ub (v : t) : int = (1 lsl (msb_of v + 1)) - 1

(* When rewriting a checked comparison [y + l <op> x + r] into one with a
   single symbolic sum (e.g. [y <op> x + (r - l)]), that rebuilt sum is only
   guaranteed not to overflow when the joined constant [d] lies between [0] and
   [base] (then [v + d] sits between the in-range values [v] and [v + base]).
   [base] and [d] are the signed values of the constants. *)
let const_keeps_in_range (base : int) (d : int) : bool =
  zmin 0 base <= d && d <= zmax 0 base

(* Whether [v <s 0]: whether this node is negative if we can tell, and
   otherwise the node that represents the sign bit *)
(* Whether [a] is a factor that can be cancelled on both sides of a comparison
   of products that do not overflow *)
let cancellable (signed : bool) (a : t) : bool =
  if signed then
    match a with BitVec x -> bv_to_z true (size a) x > 0 | _ -> false
  else sure_neq a (bv_zero (size a))

let rec lt_zero_aux (v : t) : t =
  let lt_zero (v : t) = Lt (true, v, bv_zero (size v)) <| TBool in
  let not_eq_0 (v : t) = b_not (sem_eq v (bv_zero (size v))) in
  match v with
  | BvExtend (true, _, v) -> lt_zero_aux v
  | BvExtend (false, k, _) when k > 0 -> v_false
  | Rem (true, l, _) -> b_and (lt_zero_aux l) (not_eq_0 v)
  | BvConcat (l, _) -> lt_zero_aux l
  | BvNot v -> b_not (lt_zero_aux v)
  | BvOfBool (n, _) when n > 1 -> v_false
  | Ite (_, l, r) ->
      let pos_l = lt_zero_aux l in
      let pos_r = lt_zero_aux r in
      if equal pos_l pos_r then pos_l else lt_zero v
  | _ -> lt_zero v

let[@spec Lt (signed, v1, v2) <| TBool] bv_lt (signed : bool) (v1 : t) (v2 : t)
    : t =
  assert (ty v1 = ty v2);
  let bits = size v1 in
  let chk = checked_of_signed signed in
  match (v1, v2) with
  | BitVec l, BitVec r [@r lits] ->
      of_bool (bv_to_z signed bits l < bv_to_z signed bits r)
  | v, v [@r same] -> v_false
  (* -a < -b <=> b < a, when neither negation overflows *)
  | Neg (true, a), Neg (true, b) [@r negs] when signed -> bv_lt signed b a
  (* -a < c <=> -c < a, when -a doesn't overflow and c <> INT_MIN *)
  | Neg (true, a), BitVec c [@r neg_l]
    when signed && not (bv_to_z signed bits c = min_for signed bits) ->
      bv_lt signed (bv_neg false v2) a
  (* c < -a <=> a < -c, when -a doesn't overflow and c <> INT_MIN *)
  | BitVec c, Neg (true, a) [@r neg_r]
    when signed && not (bv_to_z signed bits c = min_for signed bits) ->
      bv_lt signed a (bv_neg false v1)
  (* c < r + x <=> c - r < x *)
  | BitVec bv_v1, Add (checked, (BitVec bv_r as r), x) [@comm] [@r const_add]
    when checked_has signed checked ->
      if (not signed) && bv_v1 < bv_r then v_true
      else if overflows_sub signed bits bv_v1 bv_r then
        Lt (signed, v1, v2) <| TBool
      else bv_lt signed (bv_sub chk v1 r) x
  (* l + x < c <=> x < c - l *)
  | Add (checked, (BitVec bv_l as l), x) [@comm], BitVec bv_v2 [@r add_const]
    when checked_has signed checked ->
      if (not signed) && bv_v2 < bv_l then v_false
      else if overflows_sub signed bits bv_v2 bv_l then
        Lt (signed, v1, v2) <| TBool
      else bv_lt signed x (bv_sub chk v2 l)
  (* a < a + b when + doesn't overflow is equivalent to 0 < b *)
  | a, Add (checked, a, b) [@comm] [@r self_add_r]
    when checked_has signed checked ->
      bv_lt signed (bv_zero bits) b
  (* a + b < a when + doesn't overflow is equivalent to b < 0 *)
  | Add (checked, a, b) [@comm], a [@r self_add_l]
    when checked_has signed checked ->
      bv_lt signed b (bv_zero bits)
  | ( Add (checked_l, (BitVec bv_l as l), y) [@comm],
      Add (checked_r, (BitVec bv_r as r), x) [@comm] ) [@r add_add]
    when checked_has signed checked_l && checked_has signed checked_r ->
      (* y + l < x + r <=> y + (l - r) < x <=> y < x + (r - l); only sound when
         the rebuilt symbolic sum is known not to overflow. *)
      let int_l = bv_to_z signed bits bv_l in
      let int_r = bv_to_z signed bits bv_r in
      if const_keeps_in_range int_l (int_l - int_r) then
        bv_lt signed (bv_add chk y (bv_sub chk l r)) x
      else if const_keeps_in_range int_r (int_r - int_l) then
        bv_lt signed y (bv_add chk x (bv_sub chk r l))
      else Lt (signed, v1, v2) <| TBool
  (* unsigned x < 1 is x == 0 *)
  | _, 1 [@r one] when not signed -> sem_eq v1 (bv_zero bits)
  (* x < ite(b, 1, 0)
   * => ite(b, x < 1, x < 0)
   * => ite(b, x = 0, false)
   * => b && x = 0 *)
  | _, BvOfBool (n, b) [@r of_bool] when not signed ->
      b_and b (sem_eq v1 (bv_zero n))
  | Ite (b, l, r), _ [@r ite_l] ->
      b_ite b (bv_lt signed l v2) (bv_lt signed r v2)
  | _, Ite (b, l, r) [@r ite_r] ->
      b_ite b (bv_lt signed v1 l) (bv_lt signed v1 r)
  | _, 0 [@r lt_zero] when signed && not (is_checked_unsigned_op v1) ->
      lt_zero_aux v1
  | BitVec x, _ [@r max_l] when bv_to_z signed bits x = max_for signed bits ->
      v_false
  | _, BitVec x [@r min_r] when bv_to_z signed bits x = min_for signed bits ->
      v_false
  | BitVec x, _ [@r min_l] when bv_to_z signed bits x = min_for signed bits ->
      b_not (sem_eq v1 v2)
  | _, BitVec x [@r max_r] when bv_to_z signed bits x = max_for signed bits ->
      b_not (sem_eq v1 v2)
  (* c2 < x * c1 *)
  | BitVec c2, Mul (checked, x, (BitVec c1 as vc1)) [@comm] [@r const_mul]
    when checked_has signed checked && c1 <> 0 ->
      let c1 = bv_to_z signed bits c1 in
      let c2 = bv_to_z signed bits c2 in
      if divisible c2 c1 || c2 >= 0 then
        if c1 < 0 then
          if signed && c1 = -1 && c2 = min_for signed bits then v_true
          else bv_lt signed x (bv_div signed v1 vc1)
        else bv_lt signed (bv_div signed v1 vc1) x
      else if c1 < 0 then bv_leq signed x (bv_div signed v1 vc1)
      else bv_leq signed (bv_div signed v1 vc1) x
  (* x * c1 < c2 *)
  | Mul (checked, x, (BitVec c1 as vc1)) [@comm], BitVec c2 [@r mul_const]
    when checked_has signed checked && c1 <> 0 ->
      let c1 = bv_to_z signed bits c1 in
      let c2 = bv_to_z signed bits c2 in
      if divisible c2 c1 || c2 < 0 then
        if c1 < 0 then
          if signed && c1 = -1 && c2 = min_for signed bits then v_false
          else bv_lt signed (bv_div signed v2 vc1) x
        else bv_lt signed x (bv_div signed v2 vc1)
      else if c1 < 0 then bv_leq signed (bv_div signed v2 vc1) x
      else bv_leq signed x (bv_div signed v2 vc1)
  (* a * x < a * y <=> x < y, when a is non-zero (positive if signed) and
     neither product overflows *)
  | Mul (checked_l, a, x) [@comm], Mul (checked_r, a, y) [@comm] [@r mul_mul]
    when checked_has signed checked_l
         && checked_has signed checked_r
         && cancellable signed a ->
      bv_lt signed x y
  (* v1 < x - k <=> v1 + k < x (when v1 + k doesn't overflow) *)
  | BitVec bv_v1, Sub (checked, x, (BitVec bv_k as k)) [@r const_sub1]
    when checked_has signed checked ->
      if overflows_add signed bits bv_v1 bv_k then
        if not signed then v_false else Lt (signed, v1, v2) <| TBool
      else bv_lt signed (bv_add chk v1 k) x
  (* v1 < k - x <=> x < k - v1 (when k - v1 doesn't overflow) *)
  | BitVec bv_v1, Sub (checked, (BitVec bv_k as k), x) [@r const_sub2]
    when checked_has signed checked ->
      if overflows_sub signed bits bv_k bv_v1 then
        if not signed then v_false else Lt (signed, v1, v2) <| TBool
      else bv_lt signed x (bv_sub chk k v1)
  (* x - k < v2 <=> x < v2 + k (when v2 + k doesn't overflow) *)
  | Sub (checked, x, (BitVec bv_k as k)), BitVec bv_v2 [@r sub_const1]
    when checked_has signed checked ->
      if overflows_add signed bits bv_v2 bv_k then
        if not signed then v_true else Lt (signed, v1, v2) <| TBool
      else bv_lt signed x (bv_add chk v2 k)
  (* k - x < v2 <=> k - v2 < x (when k - v2 doesn't overflow) *)
  | Sub (checked, (BitVec bv_k as k), x), BitVec bv_v2 [@r sub_const2]
    when checked_has signed checked ->
      if overflows_sub signed bits bv_k bv_v2 then
        if not signed then v_true else Lt (signed, v1, v2) <| TBool
      else bv_lt signed (bv_sub chk k v2) x
  (* v1 <u c is true when v1's value can't reach c *)
  | _, BitVec c [@r ub_r] when (not signed) && unsigned_ub v1 < c -> v_true
  (* c <u v2 is false when v2's value can't exceed c *)
  | BitVec c, _ [@r ub_l] when (not signed) && unsigned_ub v2 <= c -> v_false
  | BitVec c, _ [@r to_unsigned_l] when signed && is_checked_unsigned_op v2 ->
      signed_to_unsigned_cmp false true c v1 v2
  | _, BitVec c [@r to_unsigned_r] when signed && is_checked_unsigned_op v1 ->
      signed_to_unsigned_cmp false false c v1 v2
  | _ [@r default] -> Lt (signed, v1, v2) <| TBool

let[@spec Leq (signed, v1, v2) <| TBool] bv_leq (signed : bool) (v1 : t)
    (v2 : t) : t =
  assert (ty v1 = ty v2);
  let bits = size v1 in
  let chk = checked_of_signed signed in
  match (v1, v2) with
  | v, v [@r same] -> v_true
  | BitVec l, BitVec r [@r lits] ->
      of_bool (bv_to_z signed bits l <= bv_to_z signed bits r)
  (* -a <= -b <=> b <= a, when neither negation overflows *)
  | Neg (true, a), Neg (true, b) [@r negs] when signed -> bv_leq signed b a
  (* -a <= c <=> -c <= a, when -a doesn't overflow and c <> INT_MIN *)
  | Neg (true, a), BitVec c [@r neg_l]
    when signed && not (bv_to_z signed bits c = min_for signed bits) ->
      bv_leq signed (bv_neg false v2) a
  (* c <= -a <=> a <= -c, when -a doesn't overflow and c <> INT_MIN *)
  | BitVec c, Neg (true, a) [@r neg_r]
    when signed && not (bv_to_z signed bits c = min_for signed bits) ->
      bv_leq signed a (bv_neg false v1)
  (* c <= r + x <=> c - r <= x *)
  | BitVec bv_v1, Add (checked, (BitVec bv_r as r), x) [@comm] [@r const_add]
    when checked_has signed checked ->
      if (not signed) && bv_v1 < bv_r then v_true
      else if overflows_sub signed bits bv_v1 bv_r then
        Leq (signed, v1, v2) <| TBool
      else bv_leq signed (bv_sub chk v1 r) x
  (* l + x <= c <=> x <= c - l *)
  | Add (checked, (BitVec bv_l as l), x) [@comm], BitVec bv_v2 [@r add_const]
    when checked_has signed checked ->
      if (not signed) && bv_v2 < bv_l then v_false
      else if overflows_sub signed bits bv_v2 bv_l then
        Leq (signed, v1, v2) <| TBool
      else bv_leq signed x (bv_sub chk v2 l)
  | ( Add (checked_l, (BitVec bv_l as l), y) [@comm],
      Add (checked_r, (BitVec bv_r as r), x) [@comm] ) [@r add_add]
    when checked_has signed checked_l && checked_has signed checked_r ->
      (* y + l <= x + r <=> y + (l - r) <= x <=> y <= x + (r - l); only sound
         when the rebuilt symbolic sum is known not to overflow. *)
      let int_l = bv_to_z signed bits bv_l in
      let int_r = bv_to_z signed bits bv_r in
      if const_keeps_in_range int_l (int_l - int_r) then
        bv_leq signed (bv_add chk y (bv_sub chk l r)) x
      else if const_keeps_in_range int_r (int_r - int_l) then
        bv_leq signed y (bv_add chk x (bv_sub chk r l))
      else Leq (signed, v1, v2) <| TBool
  (* a <= a + b when + doesn't overflow is equivalent to 0 <= b *)
  | a, Add (checked, a, b) [@comm] [@r self_add_r]
    when checked_has signed checked ->
      bv_leq signed (bv_zero bits) b
  (* a + b <= a when + doesn't overflow is equivalent to b <= 0 *)
  | Add (checked, a, b) [@comm], a [@r self_add_l]
    when checked_has signed checked ->
      bv_leq signed b (bv_zero bits)
  | BitVec x, _ [@r min_l] when bv_to_z signed bits x = min_for signed bits ->
      v_true
  | _, BitVec x [@r max_r] when bv_to_z signed bits x = max_for signed bits ->
      v_true
  (* c2 <= x * c1 *)
  | BitVec c2, Mul (checked, x, (BitVec c1 as vc1)) [@comm] [@r const_mul]
    when checked_has signed checked && c1 <> 0 ->
      let c1 = bv_to_z signed bits c1 in
      let c2 = bv_to_z signed bits c2 in
      if divisible c2 c1 then
        if c1 < 0 then
          if signed && c1 = -1 && c2 = min_for signed bits then v_true
          else bv_leq signed x (bv_div signed v1 vc1)
        else bv_leq signed (bv_div signed v1 vc1) x
      else if c1 < 0 then
        if c2 < 0 then bv_leq signed x (bv_div signed v1 vc1)
        else bv_lt signed x (bv_div signed v1 vc1)
      else if c2 < 0 then bv_leq signed (bv_div signed v1 vc1) x
      else bv_lt signed (bv_div signed v1 vc1) x
  (* x * c1 <= c2 *)
  | Mul (checked, x, (BitVec c1 as vc1)) [@comm], BitVec c2 [@r mul_const]
    when checked_has signed checked && c1 <> 0 ->
      let c1 = bv_to_z signed bits c1 in
      let c2 = bv_to_z signed bits c2 in
      if divisible c2 c1 then
        if c1 < 0 then
          if signed && c1 = -1 && c2 = min_for signed bits then v_false
          else bv_leq signed (bv_div signed v2 vc1) x
        else bv_leq signed x (bv_div signed v2 vc1)
      else if c1 < 0 then
        if c2 < 0 then bv_lt signed (bv_div signed v2 vc1) x
        else bv_leq signed (bv_div signed v2 vc1) x
      else if c2 < 0 then bv_lt signed x (bv_div signed v2 vc1)
      else bv_leq signed x (bv_div signed v2 vc1)
  (* a * x <= a * y <=> x <= y, when a is non-zero (positive if signed) and
     neither product overflows *)
  | Mul (checked_l, a, x) [@comm], Mul (checked_r, a, y) [@comm] [@r mul_mul]
    when checked_has signed checked_l
         && checked_has signed checked_r
         && cancellable signed a ->
      bv_leq signed x y
  (* x /u d <= n when n * d exceeds the maximum *)
  | Div (false, _, BitVec d), BitVec n [@r udiv_big]
    when (not signed) && n * d > max_for false bits ->
      v_true
  | Ite (b, l, r), BitVec _ [@r ite_l] ->
      b_ite b (bv_leq signed l v2) (bv_leq signed r v2)
  | BitVec _, Ite (b, l, r) [@r ite_r] ->
      b_ite b (bv_leq signed v1 l) (bv_leq signed v1 r)
  (* v1 <= x - k <=> v1 + k <= x (when v1 + k doesn't overflow) *)
  | BitVec bv_v1, Sub (checked, x, (BitVec bv_k as k)) [@r const_sub1]
    when checked_has signed checked ->
      if overflows_add signed bits bv_v1 bv_k then
        if not signed then v_false else Leq (signed, v1, v2) <| TBool
      else bv_leq signed (bv_add chk v1 k) x
  (* v1 <= k - x <=> x <= k - v1 (when k - v1 doesn't overflow) *)
  | BitVec bv_v1, Sub (checked, (BitVec bv_k as k), x) [@r const_sub2]
    when checked_has signed checked ->
      if overflows_sub signed bits bv_k bv_v1 then
        if not signed then v_false else Leq (signed, v1, v2) <| TBool
      else bv_leq signed x (bv_sub chk k v1)
  (* x - k <= v2 <=> x <= v2 + k (when v2 + k doesn't overflow) *)
  | Sub (checked, x, (BitVec bv_k as k)), BitVec bv_v2 [@r sub_const1]
    when checked_has signed checked ->
      if overflows_add signed bits bv_v2 bv_k then
        if not signed then v_true else Leq (signed, v1, v2) <| TBool
      else bv_leq signed x (bv_add chk v2 k)
  (* k - x <= v2 <=> k - v2 <= x (when k - v2 doesn't overflow) *)
  | Sub (checked, (BitVec bv_k as k), x), BitVec bv_v2 [@r sub_const2]
    when checked_has signed checked ->
      if overflows_sub signed bits bv_k bv_v2 then
        if not signed then v_true else Leq (signed, v1, v2) <| TBool
      else bv_leq signed (bv_sub chk k v2) x
  (* v1 <=u c is true when v1's value can't exceed c *)
  | _, BitVec c [@r ub_r] when (not signed) && unsigned_ub v1 <= c -> v_true
  (* c <=u v2 is false when v2's value can't reach c *)
  | BitVec c, _ [@r ub_l] when (not signed) && unsigned_ub v2 < c -> v_false
  | BitVec c, _ [@r to_unsigned_l] when signed && is_checked_unsigned_op v2 ->
      signed_to_unsigned_cmp true true c v1 v2
  | _, BitVec c [@r to_unsigned_r] when signed && is_checked_unsigned_op v1 ->
      signed_to_unsigned_cmp true false c v1 v2
  | _ [@r default] -> Leq (signed, v1, v2) <| TBool

(* Rewrites a signed comparison [v1 R v2] (with [R] being [<=] when [is_leq],
   else [<]) where the concrete operand [c] is on the [c_on_left] side and the
   other operand is a checked-unsigned operation, into an equivalent unsigned
   formula. This lets the checked-unsigned reductions fire. Splitting the
   non-constant operand [X] at the sign threshold [s = 2^(bits-1)] (so [X <u s]
   is its non-negative half), and with [c_cmp] the same comparison taken
   unsigned:
   - [c] on the left: [c R X <=> c_cmp && X <u s] if [c >=s 0]
     [c R X <=> X <u s || c_cmp] if [c <s 0]
   - [c] on the right: [X R c <=> c_cmp || s <=u X] if [c >=s 0]
     [X R c <=> s <=u X && c_cmp] if [c <s 0] *)
let signed_to_unsigned_cmp (is_leq : bool) (c_on_left : bool) (c : int)
    (v1 : t) (v2 : t) : t =
  let bits = size v1 in
  let sign_bit = mk_bv bits (1 lsl (bits - 1)) in
  let c_cmp = if is_leq then bv_leq false v1 v2 else bv_lt false v1 v2 in
  let nonneg = bv_to_z true bits c >= 0 in
  if c_on_left then
    let in_pos = bv_lt false v2 sign_bit in
    if nonneg then b_and c_cmp in_pos else b_or in_pos c_cmp
  else
    let in_neg = bv_leq false sign_bit v1 in
    if nonneg then b_or c_cmp in_neg else b_and in_neg c_cmp

(* Overflow checks *)

let[@spec AddOvf (signed, v1, v2) <| TBool] bv_add_overflows (signed : bool)
    (v1 : t) (v2 : t) : t =
  match (v1, v2) with
  | BitVec l, BitVec r [@r lits] -> of_bool (overflows_add signed (size v1) l r)
  | (0, _) [@comm] [@r zero] -> v_false
  | _ [@r size1] when size v1 = 1 ->
      let one = bv_one 1 in
      b_and (sem_eq v1 one) (sem_eq v2 one)
  (* z + x overflows iff max - z < x *)
  | (BitVec z, x) [@comm] [@r unsigned] when not signed ->
      let n = size v1 in
      bv_lt signed (mk_bv n (max_for signed n - z)) x
  | (BitVec z, x) [@comm] [@r signed] when signed ->
      let n = size v1 in
      let z = bv_to_z signed n z in
      if z > 0 then
        (* z > 0 so overflows if max - z < x *)
        bv_lt signed (mk_bv n (max_for signed n - z)) x
      else
        (* z < 0 so overflows if x < min - z *)
        bv_lt signed x (mk_masked n (min_for signed n - z))
  | BvOfBool (n, b1), BvOfBool (_, b2) [@r of_bools] when n > 1 ->
      if signed && n = 2 then
        (* Signed addition of two booleans of size 2 overflows iff they are both
           true *)
        b_and b1 b2
      else v_false
  (* ite(b, 1, 0) + x only overflows if b && x == max *)
  | (BvOfBool (_, b), other) [@comm] [@r of_bool] when size v1 > 1 ->
      let n = size v1 in
      let other = kind other <| TBitVector n in
      b_and b (sem_eq other (mk_bv n (max_for signed n)))
  | _ [@r default] -> mk_commut_binop (AddOvf signed) v1 v2 <| TBool

let[@spec MulOvf (signed, v1, v2) <| TBool] bv_mul_overflows (signed : bool)
    (v1 : t) (v2 : t) : t =
  match (v1, v2) with
  | BitVec l, BitVec r [@r lits] -> of_bool (overflows_mul signed (size v1) l r)
  | _ [@r size1] when signed && size v1 = 1 ->
      (* We need to special-case size one because the other simplifications will
         mess with that case, and it's pretty easy to simplify. *)
      let one = bv_one 1 in
      b_and (sem_eq v1 one) (sem_eq v2 one)
  | _ [@r msb]
    when if signed then msb_of v1 + msb_of v2 < size v1 - 2
         else msb_of v1 + msb_of v2 < size v1 - 1 ->
      v_false
  | (BitVec z, x) [@comm] [@r const] when (not signed) || size v1 > 1 ->
      if z = 0 || z = 1 then v_false
      else
        let n = size v1 in
        let x = kind x <| ty v1 in
        let z = bv_to_z signed n z in
        if signed then
          (* For signed overflow, the correct condition is: z * x overflows iff
             x < min_x or x > max_x, where min_x = ceil((-2^(n-1))/z), max_x =
             floor((2^(n-1)-1)/z) for z > 0, and swapped for z < 0. *)
          let min_val = -(1 lsl (n - 1)) in
          let max_val = (1 lsl (n - 1)) - 1 in
          if z = -1 then
            (* z = -1: only overflows when x = MIN_VALUE *)
            sem_eq x (mk_masked n min_val)
          else
            let min_x, max_x =
              if z > 0 then (tdiv min_val z, tdiv max_val z)
              else (tdiv max_val z, tdiv min_val z)
            in
            b_or
              (bv_lt signed x (mk_masked n min_x))
              (bv_lt signed (mk_masked n max_x) x)
        else
          (* For unsigned overflow, z * x overflows iff x > floor((2^n - 1) /
             z) *)
          bv_lt signed (mk_bv n (tdiv ((1 lsl n) - 1) z)) x
  (* `x * (y / x)` cannot overflow with unsigned ops *)
  | (x, Div (false, _, x)) [@comm] [@r div] when not signed -> v_false
  | _ [@r default] -> mk_commut_binop (MulOvf signed) v1 v2 <| TBool

let[@spec Eq (mk_masked (size v) (min_for true (size v)), v) <| TBool]
    bv_neg_overflows (v : t) : t =
  let n = size v in
  sem_eq (mk_masked n (min_for true n)) v

let[@spec SubOvf (signed, v1, v2) <| TBool] bv_sub_overflows (signed : bool)
    (v1 : t) (v2 : t) : t =
  match (v1, v2) with
  | BitVec l, BitVec r [@r lits] -> of_bool (overflows_sub signed (size v1) l r)
  | v, v [@r same] -> v_false
  | _ [@r unsigned] when not signed -> bv_lt signed v1 v2
  | _ [@r default] -> SubOvf (signed, v1, v2) <| TBool

(* Float-bit-vector conversions *)

let[@spec BvOfFloat (rounding, signed, sz, v) <| TBitVector sz] bv_of_float
    (rounding : rm) (signed : bool) (sz : int) (v : t) : t =
  match v with
  | Float f [@r lit] -> (
      match f_to_int rounding signed sz f with
      | Some z -> mk_masked sz z
      (* NaN, infinite, or out of range: SMT-Lib leaves the result unspecified,
         so we keep the term symbolic. *)
      | None -> BvOfFloat (rounding, signed, sz, v) <| TBitVector sz)
  | _ [@r default] -> BvOfFloat (rounding, signed, sz, v) <| TBitVector sz

let[@spec FloatOfBv (rounding, signed, fp, v) <| TFloat fp] bv_to_float
    (rounding : rm) (signed : bool) (fp : fp) (v : t) : t =
  match v with
  | BitVec z [@r lit] -> (
      match f_of_int rounding signed fp (size v) z with
      | Some f -> Float f <| TFloat fp
      | None -> FloatOfBv (rounding, signed, fp, v) <| TFloat fp)
  | _ [@r default] -> FloatOfBv (rounding, signed, fp, v) <| TFloat fp

let[@spec
     FloatOfBvRaw (fp_of_size (size v), v) <| TFloat (fp_of_size (size v))]
    bv_to_float_raw (v : t) : t =
  let fp = fp_of_size (size v) in
  match v with
  | BitVec z [@r lit] -> Float (f_of_bits fp z) <| TFloat fp
  | _ [@r default] -> FloatOfBvRaw (fp, v) <| TFloat fp
