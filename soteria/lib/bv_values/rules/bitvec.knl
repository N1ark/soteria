(* The bitvec module: bit-vectors, their arithmetic and bitwise operations, and
   their comparisons. *)

type bv [@lean "BvVal"] [@equal "bv_equal"]

node BitVec of int [@literal bv] [@to_term lit] [@of_term bv_of_lit]
    [@raw to_z lit_to_z] [@raw width lit_width]
node BvOfBool of nat (n) : TBool -> TBitVector n
node BvExtract of nat * nat (i, j) : TBitVector n -> TBitVector (j - i + 1)
    when 0 <= i && i <= j && j < n [@fold lit_extract]
node BvExtend of bool * nat (_, k) : TBitVector n -> TBitVector (n + k)
    when 0 <= k
node BvNot : TBitVector n -> TBitVector n [@fold lit_not] [@distrib_ite]
node Neg of bool : TBitVector n -> TBitVector n
    [@fold lit_neg] [@invol] [@distrib_ite]
node Add of checked : TBitVector n -> TBitVector n -> TBitVector n [@comm]
    [@fold lit_add]
node Sub of checked : TBitVector n -> TBitVector n -> TBitVector n
    [@fold lit_sub]
node Mul of checked : TBitVector n -> TBitVector n -> TBitVector n [@comm]
    [@fold lit_mul] [@unit 1] [@zero 0]
node Div of bool : TBitVector n -> TBitVector n -> TBitVector n
node Rem of bool : TBitVector n -> TBitVector n -> TBitVector n
node Mod : TBitVector n -> TBitVector n -> TBitVector n [@fold lit_smod]
node AddOvf of bool : TBitVector n -> TBitVector n -> TBool [@comm]
    [@fold add_overflows]
node SubOvf of bool : TBitVector n -> TBitVector n -> TBool
    [@fold sub_overflows]
node MulOvf of bool : TBitVector n -> TBitVector n -> TBool [@comm]
    [@fold mul_overflows]
node Lt of bool : TBitVector n -> TBitVector n -> TBool
node Leq of bool : TBitVector n -> TBitVector n -> TBool
node BvConcat : TBitVector n -> TBitVector m -> TBitVector (n + m)
    [@fold lit_concat]
node BitAnd : TBitVector n -> TBitVector n -> TBitVector n [@comm]
    [@fold lit_and] [@zero 0]
node BitOr : TBitVector n -> TBitVector n -> TBitVector n [@comm]
    [@fold lit_or] [@unit 0] [@idem]
node BitXor : TBitVector n -> TBitVector n -> TBitVector n [@comm]
    [@fold lit_xor] [@unit 0]
node Shl : TBitVector n -> TBitVector n -> TBitVector n
    [@fold lit_shl] [@unit 0]
node LShr : TBitVector n -> TBitVector n -> TBitVector n
    [@fold lit_lshr] [@unit 0]
node AShr : TBitVector n -> TBitVector n -> TBitVector n
    [@fold lit_ashr] [@unit 0]
node TBitVector of nat [@get size]

(* Operators on terms: [a + b] is [bv_add unchecked a b] in expressions and
   matches [Add (_, a, b)] in patterns, whatever its overflow check; on
   bit-vector values, it is [lit_add a b]. *)

infix "+" = Add, bv_add unchecked, lit_add
infix "-" = Sub, bv_sub unchecked, lit_sub
infix "*" = Mul, bv_mul unchecked, lit_mul
infix "land" = BitAnd, bv_and, lit_and
infix "lor" = BitOr, bv_or, lit_or
infix "lxor" = BitXor, bv_xor, lit_xor
infix "lsl" = Shl, bv_shl, lit_shl
infix "lsr" = LShr, bv_lshr, lit_lshr
infix "asr" = AShr, bv_ashr, lit_ashr
infix "++" = BvConcat, bv_concat
(* the remainders: [urem] is unsigned, [srem] takes the sign of the dividend
   and [mod] that of the divisor *)
infix "urem" = Rem false, bv_rem false, lit_urem
infix "srem" = Rem true, bv_rem true, lit_srem
infix "mod" = Mod, bv_mod, lit_smod
prefix "-" = Neg, bv_neg false, lit_neg
prefix "~" = BvNot, bv_not, lit_not

constant "0" (v) = bv_zero (size v)
constant "1" (v) = bv_one (size v)
