(* The bool module, at the bottom of every language: booleans, equality,
   [Ite], [Distinct] and [Exists]. See [lang.bvl] for the syntax. *)

node Bool of bool [@literal]
node Exists of (var * ty) list * t
node Not : TBool -> TBool
node And : TBool -> TBool -> TBool [@comm] [@idem]
node Or : TBool -> TBool -> TBool [@comm] [@idem]
node Eq : a -> b -> TBool when a = b [@comm]
node Ite : TBool -> a -> a -> a
node Distinct
node TBool

infix "&&" = And, b_and
infix "||" = Or, b_or
infix "==" = Eq, sem_eq
prefix "not" = Not, b_not
