(* Booleans *)

rule b_and (v1 v2 : t) : And (v1, v2) <| TBool =
  match (v1, v2) with
  | same: v, v -> v1
  | false_: (false, _) [@comm] -> v_false
  | true_l: true, _ -> v2
  | true_r: _, true -> v1
  (* p && !p <=> false *)
  | not: (p, not p) [@comm] -> v_false
  (* (a && b) && a <=> a && b *)
  | and_l: a && _ [@comm], a -> v1
  | and_r: a, a && _ [@comm] -> v2
  (* (a || b) && a <=> a *)
  | or_l: a || _ [@comm], a -> v2
  | or_r: a, a || _ [@comm] -> v1
  (* [a == x && a == y] with [x] and [y] surely different *)
  | eq_neq: a == x [@comm], a == y [@comm] when sure_neq x y -> v_false
  (* only for constants: if [bv1] or [bv2] could be undefined (an operation
     whose overflow check does not hold), the conjunction could still be false
     thanks to the other conjunct, while the merged equality would be
     undefined *)
  | eq_extracts:
      (#_ as bv1) == BvExtract (s1, e1, x), (#_ as bv2) == BvExtract (s2, e2, x)
    when e1 + 1 = s2 || e2 + 1 = s1 ->
      if e1 + 1 = s2 then bv2 ++ bv1 == bv_extract s1 e2 x
      else bv1 ++ bv2 == bv_extract s2 e1 x
  (* two upper (resp. lower) bounds on the same value (e.g. [a < c1] && [a <=
     c2]) keep the tighter one *)
  | upper_bounds:
      (Lt (s, a, #_) | Leq (s, a, #_)), (Lt (s, a, #_) | Leq (s, a, #_)) ->
      if upper_bound v1 <= upper_bound v2 then v1 else v2
  | lower_bounds:
      (Lt (s, #_, a) | Leq (s, #_, a)), (Lt (s, #_, a) | Leq (s, #_, a)) ->
      if lower_bound v1 >= lower_bound v2 then v1 else v2
  | default: _ -> mk_commut_binop And v1 v2 <| TBool

rule b_or (v1 v2 : t) : Or (v1, v2) <| TBool =
  match (v1, v2) with
  | same: v, v -> v1
  | true_: (true, _) [@comm] -> v_true
  | false_l: false, _ -> v2
  | false_r: _, false -> v1
  (* p || !p <=> true *)
  | not: (p, not p) [@comm] -> v_true
  (* [a < b || b < a] <=> [a != b] *)
  | lt_lt: Lt (s, a, b), Lt (s, b, a) -> not (a == b)
  (* [a < b || b <= a] <=> true *)
  | lt_leq: (Lt (s, a, b), Leq (s, b, a)) [@comm] -> v_true
  | or_l: a || _ [@comm], a -> v1
  | or_r: a, a || _ [@comm] -> v2
  (* (a && b) || a <=> a *)
  | and_l: a && _ [@comm], a -> v2
  | and_r: a, a && _ [@comm] -> v1
  (* an upper and a lower bound on the same value that (at least) touch cover
     the whole domain, e.g. [a <= 2] || [3 <= a] *)
  | complementary:
      ( ((Lt (s, a, #_) | Leq (s, a, #_)) as ub),
        ((Lt (s, #_, a) | Leq (s, #_, a)) as lb) ) [@comm]
    when lower_bound lb <= upper_bound ub + 1 ->
      v_true
  (* a bound absorbs an equality it already allows, e.g. [a < c] || [a ==
     0] *)
  | upper_eq: (((Lt (s, a, #_) | Leq (s, a, #_)) as b), a == #k [@comm]) [@comm]
    when to_z s k <= upper_bound b ->
      b
  | lower_eq: (((Lt (s, #_, a) | Leq (s, #_, a)) as b), a == #k [@comm]) [@comm]
    when lower_bound b <= to_z s k ->
      b
  (* two upper (resp. lower) bounds on the same value keep the looser one *)
  | upper_bounds:
      (Lt (s, a, #_) | Leq (s, a, #_)), (Lt (s, a, #_) | Leq (s, a, #_)) ->
      if upper_bound v1 <= upper_bound v2 then v2 else v1
  | lower_bounds:
      (Lt (s, #_, a) | Leq (s, #_, a)), (Lt (s, #_, a) | Leq (s, #_, a)) ->
      if lower_bound v1 >= lower_bound v2 then v2 else v1
  | default: _ -> mk_commut_binop Or v1 v2 <| TBool

rule b_not (sv : t) : Not sv <| TBool =
  match sv with
  | true_: true -> v_false
  | false_: false -> v_true
  | not: not sv -> sv
  | lt: Lt (signed, v1, v2) -> bv_leq signed v2 v1
  | leq: Leq (signed, v1, v2) -> bv_lt signed v2 v1
  | or_: v1 || v2 -> not v1 && not v2
  | and_: v1 && v2 -> not v1 || not v2
  | ite: Ite (g, a, b) -> b_ite g (not a) (not b)
  | eq_bit: (#bv as c) == v [@comm] when ty c = TBitVector 1 -> ~bv == v
  | distinct: Distinct [ l; r ] -> l == r
  | default: _ -> Not sv <| TBool

rule b_ite (guard if_ else_ : t) : Ite (guard, if_, else_) <| ty if_ =
  match (guard, if_, else_) with
  | true_: true, _, _ -> if_
  | false_: false, _, _ -> else_
  | bool: _, true, false -> guard
  | not_bool: _, false, true -> not guard
  | false_then: _, false, _ -> not guard && else_
  | true_then: _, true, _ -> guard || else_
  | false_else: _, _, false -> guard && if_
  | true_else: _, _, true -> not guard || if_
  | bv_of_bool: _, 1, 0 when is_bv (ty if_) -> bv_of_bool (size if_) guard
  | not_guard: not g, _, _ -> b_ite g else_ if_
  | guard_then: g, g, _ -> guard || else_
  | guard_else: g, _, g -> guard && if_
  | ite_then: g, Ite (g, x, _), _ -> b_ite guard x else_
  | ite_else: g, _, Ite (g, _, y) -> b_ite guard if_ y
  | and_ite_then: g && _ [@comm], Ite (g, x, _), _ -> b_ite guard x else_
  | or_ite_else: g || _ [@comm], _, Ite (g, _, y) -> b_ite guard if_ y
  | same: _, x, x -> if_
  | default: _ -> Ite (guard, if_, else_) <| ty if_

rule sem_eq (v1 v2 : t) : Eq (v1, v2) <| TBool =
  match (v1, v2) with
  | same: v, v -> v_true
  | bools: Bool b1, Bool b2 -> of_bool (b1 = b2)
  | ptrs: Ptr (l1, o1), Ptr (l2, o2) -> l1 == l2 && o1 == o2
  | bvs: #b1, #b2 -> of_bool (to_z false b1 = to_z false b2)
  | floats: Float f1, Float f2 -> of_bool (f_bits_equal f1 f2)
  (* Arithmetics *)
  | neg_r: #_, -x -> -v1 == x
  | neg_l: -x, #_ -> x == -v2
  | not_r: #_, ~x -> ~v1 == x
  | not_l: ~x, #_ -> x == ~v2
  (* c == l + r <=> c - l == r, for constants c and l *)
  | add_const_r: #_, (#_ as l) + r [@comm] -> v1 - l == r
  | add_const_l: (#_ as l) + r [@comm], #_ -> v2 - l == r
  (* c == l - r <=> c + r == l, and c == l - r <=> l - c == r *)
  | sub_const_r1: #_, l - (#_ as r) -> v1 + r == l
  | sub_const_r2: #_, (#_ as l) - r -> l - v1 == r
  | sub_const_l1: l - (#_ as r), #_ -> v2 + r == l
  | sub_const_l2: (#_ as l) - r, #_ -> l - v2 == r
  (* x == x + c <=> c == 0 *)
  | self_add_r: x, x + #bv [@comm] -> of_bool (to_z false bv = 0)
  | self_add_l: x + #bv [@comm], x -> of_bool (to_z false bv = 0)
  | add_add: (#bv_l as l) + y [@comm], (#bv_r as r) + x [@comm] ->
      (* y + l == x + r <=> y == x + (r - l) <=> y + (l - r) == x *)
      (* we pick the option that will make a positive constant (superstition);
         this rewrite holds modulo 2^n regardless of overflow, but the rebuilt
         sum carries no overflow guarantee, so it stays unchecked. *)
      if to_z false bv_l >= to_z false bv_r then x == y + (l - r)
      else y == x + (r - l)
  | mul_const: (#n, Mul (ck, #m, x) [@comm]) [@comm] when is_checked ck ->
      (* the multiplication is exact in a checked signedness, so read the
         constants in that signedness: the result must be a multiple of [m], and
         dividing recovers [x] *)
      let sz = size x in
      let signed = not ck.unsigned in
      let m = to_z signed m in
      let n = to_z signed n in
      if m = 0 then of_bool (n = 0)
      else if n = 0 then x == bv_zero sz
      else if divisible n m then
        let q = tdiv n m in
        let fits =
          if signed then
            let h = 1 lsl (sz - 1) in
            -h <= q && q < h
          else 0 <= q && q < 1 lsl sz
        in
        if fits then x == mk_masked sz q else v_false
      else v_false
  (* distributing over a shared guard lets the branches cancel pairwise *)
  | ite_ite: Ite (b, l, r), Ite (b, l', r') -> b_ite b (l == l') (r == r')
  (* Cancelling a common factor [a] from [a*b == a*d] is only sound when [a] is
     odd (invertible modulo 2^n), or when [a] is non-zero and both
     multiplications are overflow-checked (so they behave like exact integer
     arithmetic). *)
  | mul_cancel: Mul (ck1, #a, b) [@comm], Mul (ck2, #a', d) [@comm]
    when to_z false a = to_z false a'
         && (to_z false a land 1 = 1
            || (to_z false a <> 0 && is_checked (checked_meet ck1 ck2))) ->
      b == d
  (* Bitvectors *)
  (* 0 == L | R ==> 0 == L && 0 == R, splitting is better for the PC *)
  | or_zero: (0, l lor r) [@comm] ->
      let z = bv_zero (size v1) in
      l == z && r == z
  (* for N == (M & X), if N has bits set that aren't in M, then it must be
     false, since the mask would unset them *)
  | and_mask: (#n, #mask land _ [@comm]) [@comm]
    when not (to_z false (n land lognot mask) = 0) ->
      v_false
  | concat_const: ((#_ as z), l ++ r) [@comm] ->
      let size_r = size r in
      let size_l = size l in
      let z_r = bv_extract 0 (size_r - 1) z in
      let z_l = bv_extract size_r (size_r + size_l - 1) z in
      l == z_l && r == z_r
  | zext_const: (BvExtend (false, by, bv), #z) [@comm] ->
      let z = to_z false z in
      let size_bv = size bv in
      (* if any of the bits of z are set in [size_bv, size_bv+by), this cannot
         be true since they're extended to 0 *)
      let mask = ((1 lsl by) - 1) lsl size_bv in
      if not (z land mask = 0) then v_false
      else
        let z_bv = mk_bv size_bv z in
        bv == z_bv
  (* ite(b, A::B, C::D) == l :: r <=>
   * ite(b, A, C) == l && ite(b, B, D) == r *)
  | ite_concat: (Ite (b, (#_ as t), (#_ as e)), l ++ r) [@comm] ->
      let size_r = size r in
      let size_l = size l in
      let t_r = bv_extract 0 (size_r - 1) t in
      let t_l = bv_extract size_r (size_r + size_l - 1) t in
      let e_r = bv_extract 0 (size_r - 1) e in
      let e_l = bv_extract size_r (size_r + size_l - 1) e in
      b_ite b t_l e_l == l && b_ite b t_r e_r == r
  | concat_concat: l1 ++ r1, l2 ++ r2 when size l1 = size l2 ->
      l1 == l2 && r1 == r2
  (* BvOfBool and If-then-elses *)
  | ite_const_l: Ite (b, l, t), (#_ | Bool _) -> b_ite b (l == v2) (t == v2)
  | ite_const_r: (#_ | Bool _), Ite (b, l, t) -> b_ite b (v1 == l) (v1 == t)
  | false_l: false, _ -> not v2
  | false_r: _, false -> not v1
  | true_l: true, _ -> v2
  | true_r: _, true -> v1
  | of_bools: BvOfBool (_, b), BvOfBool (_, c) -> b == c
  | nots: not b, not c -> b == c
  | of_bool_const: (BvOfBool (_, b), #z) [@comm] ->
      let z = to_z false z in
      if z = 1 then b else if z = 0 then not b else v_false
  (* special case: for BVs, check if we can infer the most significant set bits
     and extract *)
  | msb: _
    when is_bv (ty v1)
         && is_bv (ty v2)
         &&
         let msb = zmax (msb_of v1) (msb_of v2) in
         0 <= msb && msb < size v1 - 1 ->
      let msb = zmax (msb_of v1) (msb_of v2) in
      let v1' = bv_extract 0 msb v1 in
      let v2' = bv_extract 0 msb v2 in
      v1' == v2'
  | default: _ -> mk_commut_binop Eq v1 v2 <| TBool

rule b_mk_exists (binders : (var * ty) list) (body : t) :
    Exists (binders, body) <| TBool =
  match body with
  | empty: _ when no_binders (used_binders binders body) -> body
  | default: _ -> Exists (used_binders binders body, body) <| TBool

rule sem_eq_untyped (v1 v2 : t) : Eq (v1, v2) <| TBool =
  match (v1, v2) with
  | ill_typed: _ when not (ty v1 = ty v2) -> v_false
  | typed: _ -> v1 == v2

(* [distinct_check_one a rest] and [distinct_check l] go through the pairs of
   elements in order, and stop at the first pair that is equal ([Some false])
   or not surely different ([None]). *)
fn distinct_check_one (a : t) (rest : t list) : bool option =
  match rest with
  | [] -> Some true
  | b :: rest ->
      if equal a b then Some false
      else if sure_neq a b then distinct_check_one a rest
      else None

fn distinct_check (l : t list) : bool option =
  match l with
  | [] -> Some true
  | a :: rest -> (
      match distinct_check_one a rest with
      | Some true -> distinct_check rest
      | r -> r)

rule b_distinct (l : t list) : Distinct l <| TBool =
  match l with
  | small: _ when at_most_one l -> v_true
  | distinct: _ when distinct_check l = Some true -> v_true
  | not_distinct: _ when distinct_check l = Some false -> v_false
  | default: _ -> Distinct (sort_by_tag l) <| TBool
