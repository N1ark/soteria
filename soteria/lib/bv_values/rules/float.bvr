(* Floating point *)

let fp_of (v : t) : fp = fp_of_ty (ty v)

let[@spec Unop (FIs fc, sv) <| TBool] float_is_floatclass (fc : fc) (sv : t) : t =
  match sv with
  | Float f [@r lit] -> of_bool (f_is_class fc f)
  | _ [@r default] -> Unop (FIs fc, sv) <| TBool

let[@spec Unop (FIsNeg, v) <| TBool] float_is_negative (v : t) : t =
  match v with
  | Float f [@r lit] -> of_bool (f_is_negative f)
  | _ [@r default] -> Unop (FIsNeg, v) <| TBool

let[@spec Unop (FIsPos, v) <| TBool] float_is_positive (v : t) : t =
  match v with
  | Float f [@r lit] -> of_bool (f_is_positive f)
  | _ [@r default] -> Unop (FIsPos, v) <| TBool

let[@spec Unop (FloatOfFloat (rounding, fp), v) <| TFloat fp] float_cast
    (rounding : rm) (fp : fp) (v : t) : t =
  match v with
  | Float f [@r lit] -> Float (f_convert rounding fp f) <| TFloat fp
  | _ [@r same] when fp_of v = fp -> v
  | _ [@r default] -> Unop (FloatOfFloat (rounding, fp), v) <| TFloat fp

let[@spec Binop (FEq, v1, v2) <| TBool] float_eq (v1 : t) (v2 : t) : t =
  match (v1, v2) with
  | Float f1, Float f2 [@r lits] -> of_bool (f_eq f1 f2)
  | _ [@r same] when equal v1 v2 -> b_not (float_is_floatclass NaN v1)
  (* Against a constant, [fp.eq] is decidable structurally *)
  | Float f, _ [@r lit_l] ->
      if f_is_nan f then v_false
      else if f_is_zero f then float_is_floatclass Zero v2
      else sem_eq v1 v2
  | _, Float f [@r lit_r] ->
      if f_is_nan f then v_false
      else if f_is_zero f then float_is_floatclass Zero v1
      else sem_eq v1 v2
  | _ [@r default] -> mk_commut_binop FEq v1 v2 <| TBool

let[@spec Binop (FLt, v1, v2) <| TBool] float_lt (v1 : t) (v2 : t) : t =
  match (v1, v2) with
  | Float f1, Float f2 [@r lits] -> of_bool (f_lt f1 f2)
  | _ [@r default] -> Binop (FLt, v1, v2) <| TBool

let[@spec Binop (FLeq, v1, v2) <| TBool] float_leq (v1 : t) (v2 : t) : t =
  match (v1, v2) with
  | Float f1, Float f2 [@r lits] -> of_bool (f_le f1 f2)
  | _ [@r default] -> Binop (FLeq, v1, v2) <| TBool

let[@spec Binop (FAdd, v1, v2) <| ty v1] float_add (v1 : t) (v2 : t) : t =
  match (v1, v2) with
  | Float f1, Float f2 [@r lits] -> Float (f_add f1 f2) <| ty v1
  | _ [@r default] -> mk_commut_binop FAdd v1 v2 <| ty v1

let[@spec Binop (FSub, v1, v2) <| ty v1] float_sub (v1 : t) (v2 : t) : t =
  match (v1, v2) with
  | Float f1, Float f2 [@r lits] -> Float (f_sub f1 f2) <| ty v1
  | _ [@r default] -> Binop (FSub, v1, v2) <| ty v1

let[@spec Binop (FDiv, v1, v2) <| ty v1] float_div (v1 : t) (v2 : t) : t =
  match (v1, v2) with
  | Float f1, Float f2 [@r lits] -> Float (f_div f1 f2) <| ty v1
  | _ [@r default] -> Binop (FDiv, v1, v2) <| ty v1

let[@spec Binop (FMul, v1, v2) <| ty v1] float_mul (v1 : t) (v2 : t) : t =
  match (v1, v2) with
  | Float f1, Float f2 [@r lits] -> Float (f_mul f1 f2) <| ty v1
  | _ [@r default] -> mk_commut_binop FMul v1 v2 <| ty v1

let[@spec Binop (FRem, v1, v2) <| ty v1] float_rem (v1 : t) (v2 : t) : t =
  match (v1, v2) with
  | Float f1, Float f2 [@r lits] -> Float (f_rem f1 f2) <| ty v1
  | _ [@r default] -> Binop (FRem, v1, v2) <| ty v1

let[@spec Unop (FAbs, v) <| ty v] float_abs (v : t) : t =
  match v with
  | Float f [@r lit] -> Float (f_abs f) <| ty v
  | Unop (FAbs, _) [@r abs] -> v
  | _ [@r default] -> Unop (FAbs, v) <| ty v

let[@spec Unop (FNeg, v) <| ty v] float_neg (v : t) : t =
  match v with
  | Float f [@r lit] -> Float (f_neg f) <| ty v
  | Unop (FNeg, v) [@r neg] -> v
  | _ [@r default] -> Unop (FNeg, v) <| ty v

let[@spec Triop (Fma, a, b, c) <| ty a] float_fma (a : t) (b : t) (c : t) : t =
  match (a, b, c) with
  | Float fa, Float fb, Float fc [@r lits] -> Float (f_fma fa fb fc) <| ty a
  | _ [@r default] -> Triop (Fma, a, b, c) <| ty a

(* C's [fmod] (and so Rust's [%] on floats), which truncates [x/y] where
   [f_rem] rounds it to nearest. SMT-Lib has no such operator, so we emulate
   it. [raw_fmod_of_rem] is that emulation, without simplifications; it serves
   as the specification of [float_fmod_of_rem] and [f_fmod]. *)
let raw_fmod_of_rem (r : t) (v1 : t) (v2 : t) : t =
  let is_neg (v : t) = Unop (FIsNeg, v) <| TBool in
  let abs2 = Unop (FAbs, v2) <| ty v2 in
  let correction =
    Triop (Ite, is_neg v1, Unop (FNeg, abs2) <| ty v2, abs2) <| ty v2
  in
  Triop
    ( Ite,
      Binop (Eq, is_neg r, is_neg v1) <| TBool,
      r,
      Binop (FAdd, r, correction) <| ty r )
  <| ty r

(* [fmod] given an already-computed IEEE remainder, so a caller that has a
   cheaper way to obtain one can reuse it. *)
let[@spec raw_fmod_of_rem r v1 v2] float_fmod_of_rem (r : t) (v1 : t) (v2 : t) : t
    =
  let correction =
    b_ite (float_is_negative v1) (float_neg (float_abs v2)) (float_abs v2)
  in
  b_ite
    (sem_eq (float_is_negative r) (float_is_negative v1))
    r (float_add r correction)

let[@spec raw_fmod_of_rem (Binop (FRem, v1, v2) <| ty v1) v1 v2] float_fmod
    (v1 : t) (v2 : t) : t =
  match (v1, v2) with
  | Float f1, Float f2 [@r lits] -> Float (f_fmod f1 f2) <| ty v1
  | _ [@r default] -> float_fmod_of_rem (float_rem v1 v2) v1 v2

(* [fp.min]/[fp.max]: the non-NaN argument wins, and which of [-0.0] and [+0.0]
   is returned is left unspecified. *)
let[@spec Binop (FMin, v1, v2) <| ty v1] float_min (v1 : t) (v2 : t) : t =
  match (v1, v2) with
  | Float f1, Float f2 [@r lits] -> Float (f_min f1 f2) <| ty v1
  | _ [@r default] -> Binop (FMin, v1, v2) <| ty v1

let[@spec Binop (FMax, v1, v2) <| ty v1] float_max (v1 : t) (v2 : t) : t =
  match (v1, v2) with
  | Float f1, Float f2 [@r lits] -> Float (f_max f1 f2) <| ty v1
  | _ [@r default] -> Binop (FMax, v1, v2) <| ty v1

let[@spec Unop (FSqrt, v) <| ty v] float_sqrt (v : t) : t =
  match v with
  | Float f [@r lit] -> Float (f_sqrt f) <| ty v
  | _ [@r default] -> Unop (FSqrt, v) <| ty v

let[@spec Unop (FRound rm, sv) <| ty sv] float_round (rm : rm) (sv : t) : t =
  match sv with
  | Float f [@r lit] -> Float (f_round rm f) <| ty sv
  | _ [@r default] -> Unop (FRound rm, sv) <| ty sv
