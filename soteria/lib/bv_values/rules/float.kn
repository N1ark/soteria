(* Floating point *)

(* {1 Primitives} *)

(* The precision of a float type; fails otherwise. *)
prim fp_of_ty : ty -> fp

(* Floats, see [Floatml.AnyFloat] *)
prim fp_size : fp -> int
(* The precision of a float. *)
prim f_prec : float -> fp
prim fp_of_size : int -> fp
prim f_equal : float -> float -> bool
prim f_bits_equal : float -> float -> bool
prim f_to_bits : float -> int
prim f_of_bits : fp -> int -> float
prim f_nan : fp -> float
prim f_is_class : fc -> float -> bool
prim f_is_nan : float -> bool
prim f_is_zero : float -> bool
prim f_is_negative : float -> bool
prim f_is_positive : float -> bool
prim f_eq : float -> float -> bool
prim f_lt : float -> float -> bool
prim f_le : float -> float -> bool
oracle f_add : float -> float -> float
oracle f_sub : float -> float -> float
oracle f_mul : float -> float -> float
oracle f_div : float -> float -> float
oracle f_rem : float -> float -> float
oracle f_fmod : float -> float -> float
oracle f_min : float -> float -> float
oracle f_max : float -> float -> float
oracle f_fma : float -> float -> float -> float
prim f_abs : float -> float
prim f_neg : float -> float
oracle f_sqrt : float -> float
oracle f_round : rm -> float -> float
oracle f_convert : rm -> fp -> float -> float

(* [f_to_int rm signed size f] converts [f] to an integer of [size] bits, if
   that size is supported and the conversion is defined. *)
oracle f_to_int : rm -> bool -> int -> float -> int option

(* [f_of_int rm signed fp size z] converts the [size]-bit integer [z] to a
   float, if that size is supported. *)
oracle f_of_int : rm -> bool -> fp -> int -> int -> float option

(* {1 Helpers} *)

extend fn Bool.sure_neq =
  | Float a, Float b -> not (f_equal a b)

fn fp_of (v : t) : fp = fp_of_ty (type_of v)

(* {1 Rules} *)

rule is_floatclass : FIs (fc, sv)

rule is_negative : FIsNeg v

rule is_positive : FIsPos v

rule cast : FloatOfFloat (rounding, fp, v)

rule eq : FEq (v1, v2) =
  | same: v, v -> not (is_floatclass NaN v)
  (* Against a constant, [fp.eq] is decidable structurally *)
  | lit: (Float f as l), x ->
      if f_is_nan f then Bool.v_false
      else if f_is_zero f then is_floatclass Zero x
      else l == x

rule lt : FLt (v1, v2)

rule leq : FLeq (v1, v2)

rule add : FAdd (v1, v2)

rule sub : FSub (v1, v2)

rule div : FDiv (v1, v2)

rule mul : FMul (v1, v2)

rule rem : FRem (v1, v2)

rule abs : FAbs v =
  | abs: FAbs _ -> v

rule neg : FNeg v =
  | neg: FNeg v -> v

rule fma : Fma (a, b, c) =
  | lits: Float fa, Float fb, Float fc -> Float (f_fma fa fb fc)

(* C's [fmod] (and so Rust's [%] on floats), which truncates [x/y] where
   [f_rem] rounds it to nearest. SMT-Lib has no such operator, so we emulate
   it. [raw_fmod_of_rem] is that emulation, without simplifications; it serves
   as the specification of [fmod_of_rem] and [f_fmod]. *)
fn raw_fmod_of_rem (r v1 v2 : t) : t =
  let is_neg (v : t) = FIsNeg v in
  let abs2 = FAbs v2 in
  let correction =
    Ite (is_neg v1, FNeg abs2, abs2)
  in
  Ite (Eq (is_neg r, is_neg v1), r, FAdd (r, correction))

(* [fmod] given an already-computed IEEE remainder, so a caller that has a
   cheaper way to obtain one can reuse it. *)
rule fmod_of_rem (r v1 v2 : t) : raw_fmod_of_rem r v1 v2 =
  Bool.ite
    (is_negative r == is_negative v1)
    r
    (add r
       (Bool.ite (is_negative v1) (neg (abs v2)) (abs v2)))

rule fmod (v1 v2 : t) : raw_fmod_of_rem (FRem (v1, v2)) v1 v2 =
  | lits: Float f1, Float f2 -> Float (f_fmod f1 f2)
  | default: _ -> fmod_of_rem (rem v1 v2) v1 v2

(* [fp.min]/[fp.max]: the non-NaN argument wins, and which of [-0.0] and [+0.0]
   is returned is left unspecified. *)
rule min : FMin (v1, v2)

rule max : FMax (v1, v2)

rule sqrt : FSqrt v

rule round : FRound (rm, sv)

(* {1 Typed helpers}

   The classes of a float and the reversed comparisons, for the typed
   interface. *)

fn is_normal (v : TFloat p) : TBool [@no_lean] = is_floatclass Normal v
fn is_subnormal (v : TFloat p) : TBool [@no_lean] = is_floatclass Subnormal v
fn is_zero (v : TFloat p) : TBool [@no_lean] = is_floatclass Zero v
fn is_infinite (v : TFloat p) : TBool [@no_lean] = is_floatclass Infinite v
fn is_nan (v : TFloat p) : TBool [@no_lean] = is_floatclass NaN v
fn gt (a b : TFloat p) : TBool [@no_lean] = lt b a
fn geq (a b : TFloat p) : TBool [@no_lean] = leq b a

(* The rules of the bool module on floats *)

extend rule Bool.eq =
  | floats: Float f1 == Float f2 -> Bool.of_bool (f_bits_equal f1 f2)
