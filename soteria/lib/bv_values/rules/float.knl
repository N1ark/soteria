(* The float module: floating-point numbers. *)

use "core"
use builtin "bool"
use "bitvec"

node Float of float (f) : TFloat (f_prec f) [@lean_inv "float_wf"]
node BvOfFloat of rm * bool * nat (_, _, n) : TFloat p -> TBitVector n
node FloatOfBv of rm * bool * fp (_, _, p) : TBitVector n -> TFloat p
node FloatOfBvRaw of fp (p) : TBitVector (Float.fp_size p) -> TFloat p
node FloatOfFloat of rm * fp (_, p) : TFloat q -> TFloat p [@fold f_convert]
node FAbs : TFloat p -> TFloat p [@fold f_abs]
node FNeg : TFloat p -> TFloat p [@fold f_neg]
node FSqrt : TFloat p -> TFloat p [@fold f_sqrt]
node FIs of fc : TFloat p -> TBool [@fold f_is_class]
node FIsNeg : TFloat p -> TBool [@fold f_is_negative]
node FIsPos : TFloat p -> TBool [@fold f_is_positive]
node FRound of rm : TFloat p -> TFloat p [@fold f_round]
node FEq : TFloat p -> TFloat p -> TBool [@comm] [@fold f_eq]
node FLeq : TFloat p -> TFloat p -> TBool [@fold f_le]
node FLt : TFloat p -> TFloat p -> TBool [@fold f_lt]
node FAdd : TFloat p -> TFloat p -> TFloat p [@fold f_add]
node FSub : TFloat p -> TFloat p -> TFloat p [@fold f_sub]
node FMul : TFloat p -> TFloat p -> TFloat p [@fold f_mul]
node FDiv : TFloat p -> TFloat p -> TFloat p [@fold f_div]
node FRem : TFloat p -> TFloat p -> TFloat p [@fold f_rem]
node FMin : TFloat p -> TFloat p -> TFloat p [@fold f_min]
node FMax : TFloat p -> TFloat p -> TFloat p [@fold f_max]
node Fma : TFloat p -> TFloat p -> TFloat p -> TFloat p
sort TFloat of fp
