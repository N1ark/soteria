(* The language of Bv_values, in which the rules of this directory are
   written: its types, the constructors of its terms and the operators on
   them, which bvr no longer hard-codes.

   bvr generates the Lean definitions of these types, with the same names
   (CamelCased for types: [ext_ty] is [ExtTy]), except for the abstract types,
   which are defined by hand in [Bvr/Abstract.lean]. In OCaml, the types are
   defined elsewhere, in [Svalue_ast] and in soteria:

   - [[@ocaml "..."]] gives the OCaml type, if it is not the bvr type. The
     constructors of a type (and the fields of a record) are in its module.
   - A [nat] argument is an OCaml [int], which is an [int] in bvr.
   - [[@noeq]]: [=] and [<>] are not allowed at this type.
   - [[@operators]] on a kind constructor: the constructors of its first
     argument are node constructors too, [Add (c, l, r)] standing for
     [Binop (Add c, l, r)].
   - [[@comm]] on a binary operator: its operands commute.
   - [[@literal]] on a kind constructor: its literals, [true] and [false] for a
     boolean, integers and [#x] for a bit-vector.
   - [C of a * b (x, y) : s1 -> s2 when e] on an operator: its typing, from
     which bvr generates [T.WT] in [Bvr/Typing.lean]. Its operands, then its
     result, have the sorts [s1], [s2], which are terms of [ty] over the
     arguments [x], [y] of [C] and over free variables, under the condition
     [e]. A free variable stands for any sort where a sort is expected, and
     otherwise for any value of its type; a width ([nat] argument of a type) is
     positive, unless the condition constrains it.
   - Laws on an operator, from which bvr derives the first rules of its rule
     function (the one whose spec is the operator over its parameters), in
     this order, instead of writing them by hand:
     - [[@fold "f"]]: on literal operands, the result of [f] ([lits:], or
       [lit:] for a unary operator), e.g. [#l + #r -> lit_add l r];
     - [[@unit "c"]]: the literal [c] is a unit, on the right if the operator
       does not commute ([zero: x + 0 -> x], [zero: _ lsl 0 -> v1]);
     - [[@zero "c"]]: [c] is absorbing, on the right if the operator does not
       commute ([zero: _ * 0 -> bv_zero (size v1)]);
     - [[@idem]]: [same: v && v -> v];
     - [[@invol]]: on a unary operator, [neg: -x -> x];
     - [[@distrib_ite]]: on a unary operator,
       [ite: Ite (b, l, r) -> b_ite b (bv_not l) (bv_not r)].

   The types [t] (terms), [bv] (bit-vector values) and [var] (variables) are
   built into bvr. *)

type float [@ocaml "Floatml.AnyFloat.t"] [@noeq]
type ext
type ext_ty

type checked [@ocaml "Svalue_ast.checked"] =
  { signed : bool; unsigned : bool }

type kind [@ocaml "(ghost, ext, ext_ty) Svalue_ast.t_kind"] [@noeq] =
  | Var of var
  | Bool of bool [@literal]
  | Float of float
  | Ptr of t * t
  | BitVec of int [@literal]
  | Seq of t list
  | Unop of unop * t [@operators]
  | Binop of binop * t * t [@operators]
  | Triop of triop * t * t * t [@operators]
  | Nop of nop * t list [@operators]
  | Exists of (var * ty) list * t
  | Extension of ext

type unop [@ocaml "Svalue_ast.Unop.t"] =
  | Not : TBool -> TBool
  | GetPtrLoc : TPointer n -> TLoc n
  | GetPtrOfs : TPointer n -> TBitVector n
  | BvOfBool of nat (n) : TBool -> TBitVector n
  | BvOfFloat of rm * bool * nat (_, _, n) : TFloat p -> TBitVector n
  | FloatOfBv of rm * bool * fp (_, _, p) : TBitVector n -> TFloat p
  | FloatOfBvRaw of fp (p) : TBitVector (fp_size p) -> TFloat p
  | FloatOfFloat of rm * fp (_, p) : TFloat q -> TFloat p [@fold "f_convert"]
  | BvExtract of nat * nat (i, j) : TBitVector n -> TBitVector (j - i + 1)
      when 0 <= i && i <= j && j < n [@fold "lit_extract"]
  | BvExtend of bool * nat (_, k) : TBitVector n -> TBitVector (n + k)
      when 0 <= k
  | BvNot : TBitVector n -> TBitVector n [@fold "lit_not"] [@distrib_ite]
  | Neg of bool : TBitVector n -> TBitVector n
      [@fold "lit_neg"] [@invol] [@distrib_ite]
  | FAbs : TFloat p -> TFloat p [@fold "f_abs"]
  | FNeg : TFloat p -> TFloat p [@fold "f_neg"]
  | FSqrt : TFloat p -> TFloat p [@fold "f_sqrt"]
  | FIs of fc : TFloat p -> TBool [@fold "f_is_class"]
  | FIsNeg : TFloat p -> TBool [@fold "f_is_negative"]
  | FIsPos : TFloat p -> TBool [@fold "f_is_positive"]
  | FRound of rm : TFloat p -> TFloat p [@fold "f_round"]

type binop [@ocaml "Svalue_ast.Binop.t"] =
  | And : TBool -> TBool -> TBool [@comm] [@idem]
  | Or : TBool -> TBool -> TBool [@comm] [@idem]
  | Eq : a -> b -> TBool when a = b [@comm]
  | FEq : TFloat p -> TFloat p -> TBool [@comm] [@fold "f_eq"]
  | FLeq : TFloat p -> TFloat p -> TBool [@fold "f_le"]
  | FLt : TFloat p -> TFloat p -> TBool [@fold "f_lt"]
  | FAdd : TFloat p -> TFloat p -> TFloat p [@fold "f_add"]
  | FSub : TFloat p -> TFloat p -> TFloat p [@fold "f_sub"]
  | FMul : TFloat p -> TFloat p -> TFloat p [@fold "f_mul"]
  | FDiv : TFloat p -> TFloat p -> TFloat p [@fold "f_div"]
  | FRem : TFloat p -> TFloat p -> TFloat p [@fold "f_rem"]
  | FMin : TFloat p -> TFloat p -> TFloat p [@fold "f_min"]
  | FMax : TFloat p -> TFloat p -> TFloat p [@fold "f_max"]
  | Add of checked : TBitVector n -> TBitVector n -> TBitVector n [@comm]
      [@fold "lit_add"]
  | Sub of checked : TBitVector n -> TBitVector n -> TBitVector n
      [@fold "lit_sub"]
  | Mul of checked : TBitVector n -> TBitVector n -> TBitVector n [@comm]
      [@fold "lit_mul"] [@unit "1"] [@zero "0"]
  | Div of bool : TBitVector n -> TBitVector n -> TBitVector n
  | Rem of bool : TBitVector n -> TBitVector n -> TBitVector n
  | Mod : TBitVector n -> TBitVector n -> TBitVector n [@fold "lit_smod"]
  | AddOvf of bool : TBitVector n -> TBitVector n -> TBool [@comm]
      [@fold "add_overflows"]
  | SubOvf of bool : TBitVector n -> TBitVector n -> TBool
      [@fold "sub_overflows"]
  | MulOvf of bool : TBitVector n -> TBitVector n -> TBool [@comm]
      [@fold "mul_overflows"]
  | Lt of bool : TBitVector n -> TBitVector n -> TBool
  | Leq of bool : TBitVector n -> TBitVector n -> TBool
  | BvConcat : TBitVector n -> TBitVector m -> TBitVector (n + m)
      [@fold "lit_concat"]
  | BitAnd : TBitVector n -> TBitVector n -> TBitVector n [@comm]
      [@fold "lit_and"] [@zero "0"]
  | BitOr : TBitVector n -> TBitVector n -> TBitVector n [@comm]
      [@fold "lit_or"] [@unit "0"] [@idem]
  | BitXor : TBitVector n -> TBitVector n -> TBitVector n [@comm]
      [@fold "lit_xor"] [@unit "0"]
  | Shl : TBitVector n -> TBitVector n -> TBitVector n
      [@fold "lit_shl"] [@unit "0"]
  | LShr : TBitVector n -> TBitVector n -> TBitVector n
      [@fold "lit_lshr"] [@unit "0"]
  | AShr : TBitVector n -> TBitVector n -> TBitVector n
      [@fold "lit_ashr"] [@unit "0"]

type triop [@ocaml "Svalue_ast.Triop.t"] =
  | Fma : TFloat p -> TFloat p -> TFloat p -> TFloat p
  | Ite : TBool -> a -> a -> a

type nop [@ocaml "Svalue_ast.Nop.t"] =
  | Distinct

type ty [@ocaml "ext_ty Svalue_ast.ty"] =
  | TBool
  | TFloat of fp
  | TLoc of nat
  | TPointer of nat
  | TSeq of ty
  | TBitVector of nat
  | TExtension of ext_ty

type fp [@ocaml "Svalue_ast.FloatPrecision.t"] =
  | F16
  | F32
  | F64
  | F128

type rm [@ocaml "Svalue_ast.RoundingMode.t"] =
  | NearestTiesToEven
  | Truncate
  | Ceil
  | Floor
  | NearestTiesToAway

type fc [@ocaml "Svalue_ast.FloatClass.t"] =
  | Normal
  | Subnormal
  | Zero
  | Infinite
  | NaN

(* Operators on terms: [a + b] is [bv_add unchecked a b] in expressions and
   matches [Add (_, a, b)] in patterns, whatever its overflow check; on
   bit-vector values, it is [lit_add a b]. *)

infix "+" = Add, bv_add unchecked, lit_add
infix "-" = Sub, bv_sub unchecked, lit_sub
infix "*" = Mul, bv_mul unchecked, lit_mul
infix "land" = BitAnd, bv_and, lit_and
infix "lor" = BitOr, bv_or, lit_or
infix "lxor" = BitXor, bv_xor, lit_xor
infix "lsl" = Shl, bv_shl, lit_shl
infix "lsr" = LShr, bv_lshr, lit_lshr
infix "asr" = AShr, bv_ashr, lit_ashr
infix "++" = BvConcat, bv_concat
infix "&&" = And, b_and
infix "||" = Or, b_or
infix "==" = Eq, sem_eq
prefix "-" = Neg, bv_neg false, lit_neg
prefix "~" = BvNot, bv_not, lit_not
prefix "not" = Not, b_not
