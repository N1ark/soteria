(* The language of Bv_values, in which the rules of this directory are
   written: its types, with their OCaml and Lean names, the constructors of its
   terms and the operators on them, which bvr no longer hard-codes.

   - [[@ocaml "..."]] and [[@lean "..."]] give the OCaml and Lean types. The
     constructors of an OCaml type (and the fields of a record) are in the
     module of the type, and a Lean constructor is [[@lean]] of its type, dot,
     [[@lean]] of the constructor.
   - A [nat] argument is an OCaml [int], which is an [int] in bvr.
   - [[@noeq]]: [=] and [<>] are not allowed at this type.
   - [[@operators]] on a kind constructor: the constructors of its first
     argument are node constructors too, [Add (c, l, r)] standing for
     [Binop (Add c, l, r)].
   - [[@comm]] on a binary operator: its operands commute.
   - [[@literal]] on a kind constructor: its literals, [true] and [false] for a
     boolean, integers and [#x] for a bit-vector. *)

type t [@ocaml "t"] [@lean "Term"] [@noeq]
type bv [@ocaml "bv"] [@lean "BvVal"]
type var [@ocaml "Symex.Var.t"] [@lean "Int"] [@noeq]
type float [@ocaml "Floatml.AnyFloat.t"] [@lean "FloatLit"] [@noeq]
type ext [@ocaml "ext"] [@lean "Ext"]
type ext_ty [@ocaml "ext_ty"] [@lean "ExtTy"]

type checked [@ocaml "Svalue_ast.checked"] [@lean "Checked"] =
  { signed : bool; unsigned : bool }

type kind [@ocaml "(ghost, ext, ext_ty) Svalue_ast.t_kind"] [@lean "Kind"] [@noeq] =
  | Var of var [@lean "var"]
  | Bool of bool [@lean "bool"] [@literal]
  | Float of float [@lean "float"]
  | Ptr of t * t [@lean "ptr"]
  | BitVec of int [@lean "bitVec"] [@literal]
  | Seq of t list [@lean "seq"]
  | Unop of unop * t [@lean "unop"] [@operators]
  | Binop of binop * t * t [@lean "binop"] [@operators]
  | Triop of triop * t * t * t [@lean "triop"] [@operators]
  | Nop of nop * t list [@lean "nop"] [@operators]
  | Exists of (var * ty) list * t [@lean "exists_"]
  | Extension of ext [@lean "extension"]

type unop [@ocaml "Svalue_ast.Unop.t"] [@lean "Unop"] =
  | Not [@lean "not_"]
  | GetPtrLoc [@lean "getPtrLoc"]
  | GetPtrOfs [@lean "getPtrOfs"]
  | BvOfBool of nat [@lean "bvOfBool"]
  | BvOfFloat of rm * bool * nat [@lean "bvOfFloat"]
  | FloatOfBv of rm * bool * fp [@lean "floatOfBv"]
  | FloatOfBvRaw of fp [@lean "floatOfBvRaw"]
  | FloatOfFloat of rm * fp [@lean "floatOfFloat"]
  | BvExtract of nat * nat [@lean "bvExtract"]
  | BvExtend of bool * nat [@lean "bvExtend"]
  | BvNot [@lean "bvNot"]
  | Neg of bool [@lean "neg"]
  | FAbs [@lean "fAbs"]
  | FNeg [@lean "fNeg"]
  | FSqrt [@lean "fSqrt"]
  | FIs of fc [@lean "fIs"]
  | FIsNeg [@lean "fIsNeg"]
  | FIsPos [@lean "fIsPos"]
  | FRound of rm [@lean "fRound"]

type binop [@ocaml "Svalue_ast.Binop.t"] [@lean "Binop"] =
  | And [@lean "and_"] [@comm]
  | Or [@lean "or_"] [@comm]
  | Eq [@lean "eq"] [@comm]
  | FEq [@lean "fEq"] [@comm]
  | FLeq [@lean "fLeq"]
  | FLt [@lean "fLt"]
  | FAdd [@lean "fAdd"]
  | FSub [@lean "fSub"]
  | FMul [@lean "fMul"]
  | FDiv [@lean "fDiv"]
  | FRem [@lean "fRem"]
  | FMin [@lean "fMin"]
  | FMax [@lean "fMax"]
  | Add of checked [@lean "add"] [@comm]
  | Sub of checked [@lean "sub"]
  | Mul of checked [@lean "mul"] [@comm]
  | Div of bool [@lean "div"]
  | Rem of bool [@lean "rem"]
  | Mod [@lean "mod_"]
  | AddOvf of bool [@lean "addOvf"] [@comm]
  | SubOvf of bool [@lean "subOvf"]
  | MulOvf of bool [@lean "mulOvf"] [@comm]
  | Lt of bool [@lean "lt"]
  | Leq of bool [@lean "leq"]
  | BvConcat [@lean "bvConcat"]
  | BitAnd [@lean "bitAnd"] [@comm]
  | BitOr [@lean "bitOr"] [@comm]
  | BitXor [@lean "bitXor"] [@comm]
  | Shl [@lean "shl"]
  | LShr [@lean "lShr"]
  | AShr [@lean "aShr"]

type triop [@ocaml "Svalue_ast.Triop.t"] [@lean "Triop"] =
  | Fma [@lean "fma"]
  | Ite [@lean "ite"]

type nop [@ocaml "Svalue_ast.Nop.t"] [@lean "Nop"] =
  | Distinct [@lean "distinct"]

type ty [@ocaml "ext_ty Svalue_ast.ty"] [@lean "Ty"] =
  | TBool [@lean "bool"]
  | TFloat of fp [@lean "float"]
  | TLoc of nat [@lean "loc"]
  | TPointer of nat [@lean "pointer"]
  | TSeq of ty [@lean "seq"]
  | TBitVector of nat [@lean "bitVector"]
  | TExtension of ext_ty [@lean "extension"]

type fp [@ocaml "Svalue_ast.FloatPrecision.t"] [@lean "Prec"] =
  | F16 [@lean "f16"]
  | F32 [@lean "f32"]
  | F64 [@lean "f64"]
  | F128 [@lean "f128"]

type rm [@ocaml "Svalue_ast.RoundingMode.t"] [@lean "RM"] =
  | NearestTiesToEven [@lean "nearestTiesToEven"]
  | Truncate [@lean "truncate"]
  | Ceil [@lean "ceil"]
  | Floor [@lean "floor"]
  | NearestTiesToAway [@lean "nearestTiesToAway"]

type fc [@ocaml "Svalue_ast.FloatClass.t"] [@lean "FClass"] =
  | Normal [@lean "normal"]
  | Subnormal [@lean "subnormal"]
  | Zero [@lean "zero"]
  | Infinite [@lean "infinite"]
  | NaN [@lean "nan"]

(* Operators on terms: [a + b] is [bv_add unchecked a b] in expressions and
   matches [Add (_, a, b)] in patterns, whatever its overflow check; on
   bit-vector values, it is [lit_add a b]. *)

infix "+" = Add, bv_add unchecked, lit_add
infix "-" = Sub, bv_sub unchecked, lit_sub
infix "*" = Mul, bv_mul unchecked, lit_mul
infix "land" = BitAnd, bv_and, lit_and
infix "lor" = BitOr, bv_or, lit_or
infix "lxor" = BitXor, bv_xor, lit_xor
infix "lsl" = Shl, bv_shl, lit_shl
infix "lsr" = LShr, bv_lshr, lit_lshr
infix "asr" = AShr, bv_ashr, lit_ashr
infix "++" = BvConcat, bv_concat
infix "&&" = And, b_and
infix "||" = Or, b_or
infix "==" = Eq, sem_eq
prefix "-" = Neg, bv_neg false, lit_neg
prefix "~" = BvNot, bv_not, lit_not
prefix "not" = Not, b_not
