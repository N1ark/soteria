(* The language of Bv_values, in which the rules of this directory are
   written: its types, the constructors of its terms and the operators on
   them, which bvr no longer hard-codes.

   It is made of the modules [bool] and [exists], which are shared with other
   languages and live in [soteria/bvr/modules], then [bitvec], [float] and
   [ptr], in this order, each declared by its [.bvl] file with its rules in its
   [.bvr] file.
   A module declares its nodes ([node C ...], with the syntax and attributes
   of the constructors below) and its operators on terms; this file declares
   the types, as the OCaml AST has them, and places each node in one of them,
   by its name alone ([| And] in [binop]).

   bvr generates the Lean definitions of these types, with the same names
   (CamelCased for types: [ext_ty] is [ExtTy]), except for the abstract types,
   which are defined by hand in [Bvr/Abstract.lean]. In OCaml, the types are
   defined elsewhere, in [Svalue_ast] and in soteria:

   - [[@ocaml "..."]] gives the OCaml type, if it is not the bvr type. The
     constructors of a type (and the fields of a record) are in its module.
   - A [nat] argument is an OCaml [int], which is an [int] in bvr.
   - [[@noeq]]: [=] and [<>] are not allowed at this type.
   - [[@operators]] on a kind constructor: the constructors of its first
     argument are node constructors too, [Add (c, l, r)] standing for
     [Binop (Add c, l, r)].
   - [[@comm]] on a binary operator: its operands commute.
   - [[@literal]] on a kind constructor: its literals, [true] and [false] for a
     boolean, integers and [#x] for a bit-vector.
   - [C of a * b (x, y) : s1 -> s2 when e] on an operator: its typing, from
     which bvr generates [T.WT] in [Bvr/Typing.lean]. Its operands, then its
     result, have the sorts [s1], [s2], which are terms of [ty] over the
     arguments [x], [y] of [C] and over free variables, under the condition
     [e]. A free variable stands for any sort where a sort is expected, and
     otherwise for any value of its type; a width ([nat] argument of a type) is
     positive, unless the condition constrains it.
   - Laws on an operator, from which bvr derives the first rules of its rule
     function (the one whose spec is the operator over its parameters), in
     this order, instead of writing them by hand:
     - [[@fold "f"]]: on literal operands, the result of [f] ([lits:], or
       [lit:] for a unary operator), e.g. [#l + #r -> lit_add l r];
     - [[@unit "c"]]: the literal [c] is a unit, on the right if the operator
       does not commute ([zero: x + 0 -> x], [zero: _ lsl 0 -> v1]);
     - [[@zero "c"]]: [c] is absorbing, on the right if the operator does not
       commute ([zero: _ * 0 -> bv_zero (size v1)]);
     - [[@idem]]: [same: v && v -> v];
     - [[@invol]]: on a unary operator, [neg: -x -> x];
     - [[@distrib_ite]]: on a unary operator,
       [ite: Ite (b, l, r) -> b_ite b (bv_not l) (bv_not r)].

   The types [t] (terms), [bv] (bit-vector values) and [var] (variables) are
   built into bvr. *)

type float [@ocaml "Floatml.AnyFloat.t"] [@noeq]
type ext
type ext_ty

type checked [@ocaml "Svalue_ast.checked"] =
  { signed : bool; unsigned : bool }

type kind [@ocaml "(ghost, ext, ext_ty) Svalue_ast.t_kind"] [@noeq] =
  | Var of var
  | Bool
  | Float
  | Ptr
  | BitVec
  | Seq of t list
  | Unop of unop * t [@operators]
  | Binop of binop * t * t [@operators]
  | Triop of triop * t * t * t [@operators]
  | Nop of nop * t list [@operators]
  | Exists
  | Extension of ext

type unop [@ocaml "Svalue_ast.Unop.t"] =
  | Not
  | GetPtrLoc
  | GetPtrOfs
  | BvOfBool
  | BvOfFloat
  | FloatOfBv
  | FloatOfBvRaw
  | FloatOfFloat
  | BvExtract
  | BvExtend
  | BvNot
  | Neg
  | FAbs
  | FNeg
  | FSqrt
  | FIs
  | FIsNeg
  | FIsPos
  | FRound

type binop [@ocaml "Svalue_ast.Binop.t"] =
  | And
  | Or
  | Eq
  | FEq
  | FLeq
  | FLt
  | FAdd
  | FSub
  | FMul
  | FDiv
  | FRem
  | FMin
  | FMax
  | Add
  | Sub
  | Mul
  | Div
  | Rem
  | Mod
  | AddOvf
  | SubOvf
  | MulOvf
  | Lt
  | Leq
  | BvConcat
  | BitAnd
  | BitOr
  | BitXor
  | Shl
  | LShr
  | AShr

type triop [@ocaml "Svalue_ast.Triop.t"] =
  | Fma
  | Ite

type nop [@ocaml "Svalue_ast.Nop.t"] =
  | Distinct

type ty [@ocaml "ext_ty Svalue_ast.ty"] =
  | TBool
  | TFloat
  | TLoc
  | TPointer
  | TSeq of ty
  | TBitVector
  | TExtension of ext_ty

type fp [@ocaml "Svalue_ast.FloatPrecision.t"] =
  | F16
  | F32
  | F64
  | F128

type rm [@ocaml "Svalue_ast.RoundingMode.t"] =
  | NearestTiesToEven
  | Truncate
  | Ceil
  | Floor
  | NearestTiesToAway

type fc [@ocaml "Svalue_ast.FloatClass.t"] =
  | Normal
  | Subnormal
  | Zero
  | Infinite
  | NaN
