(* The value language of the C tool of Soteria, written for Kanon, which
   generates its types
   ([Bv_types]) and its simplifying smart constructors ([Bv_rules]).

   It is made of the modules that it uses: [core], [bool] (built into kanon),
   [exists], [bitvec], [float], [ptr] and [view], each declared by its [.knl]
   file with its rules in its [.kn] file. A module declares its nodes and sorts
   and uses [core], which declares the variables, the sequences (and their
   sort) and the host types of the nodes' parameters, shared with the language
   of soteria-rust. *)

[@@@lean_root "Kanon"]
[@@@lean_param "FS" "FloatSem"]
[@@@ocaml_prims "Bv_prims"]
[@@@ocaml_types "Bv_types"]
[@@@ocaml_rules "Bv_rules"]


use "core"
use builtin "bool"
use "exists"
use "bitvec"
use "float"
use "ptr"
use "view"
