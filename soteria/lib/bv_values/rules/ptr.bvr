(* Pointers *)

(* {1 Helpers} *)

extend fn sure_neq =
  | Ptr (la, oa), Ptr (lb, ob) -> sure_neq la lb || sure_neq oa ob

(* {1 Rules} *)

rule ptr_loc (p : t) : GetPtrLoc p <| TLoc (size p) =
  match p with
  | ptr: Ptr (l, _) -> l
  | default: _ -> GetPtrLoc p <| TLoc (size p)

rule ptr_ofs (p : t) : GetPtrOfs p <| TBitVector (size p) =
  match p with
  | ptr: Ptr (_, o) -> o
  | default: _ ->
      let n = size p in
      GetPtrOfs p <| TBitVector n

(* The rules of the bool module on pointers *)

extend rule sem_eq before bvs =
  | ptrs: Ptr (l1, o1) == Ptr (l2, o2) -> l1 == l2 && o1 == o2
