(* Pointers *)

(* {1 Helpers} *)

extend fn Bool.sure_neq =
  | Ptr (la, oa), Ptr (lb, ob) -> Bool.sure_neq la lb || Bool.sure_neq oa ob

(* {1 Rules} *)

rule loc : GetPtrLoc p =
  | ptr: Ptr (l, _) -> l

rule ofs : GetPtrOfs p =
  | ptr: Ptr (_, o) -> o

(* The rules of the bool module on pointers *)

extend rule Bool.eq =
  | ptrs: Ptr (l1, o1) == Ptr (l2, o2) -> l1 == l2 && o1 == o2
