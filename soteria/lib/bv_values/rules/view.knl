(* The view of the value language: what the generic host code (SMT encoder,
   evaluator, substitution, solver) needs to know of each node and sort, as
   functions in view.kn: the recognisers, the cost, the SMT encoding and the
   learning. The traversals of the terms ([map_children], [iter_children]) are
   generated by Kanon ([@@@traversals] in lang.knl).

   Everything here is host infrastructure, not a simplification rule: every
   function and primitive is [@no_lean]. The host types are those of
   [View_host] (../view_host.ml), declared again with
   [@ocaml], with the same constructors in the same order, so that the
   generated types re-export them and OCaml checks that they agree. [nat] and
   [int] are [Z.t] in the generated OCaml. The constructor names are global:
   [Inside | Outside] and not the [Pos | Neg] of the solver ([Neg] is a node
   of bitvec). *)

use "core"
use builtin "bool"
use "exists"
use "bitvec"
use "float"
use "ptr"

(* The SMT operator of the encoding of a term and of a sort: they apply to the
   encoders and to the operands, and own the order of their calls (see
   View_host) *)
type smt_op [@ocaml "(t, ty) View_host.smt_op"] [@noeq]
type smt_sort_op [@ocaml "ty View_host.smt_sort_op"] [@noeq]

(* The side of a range, see [as_range] *)
type range_sign [@ocaml "View_host.range_sign"] = Inside | Outside

type learn_plan [@ocaml "View_host.learn_plan"] =
  | LNone
  | LAlts of (int * int) list
  | LAll of int list * int list
