; The Lean types of Tiny_values, and the model, statements and assembly proof of
; its rules, are generated from the declaration of the language and the rules;
; `dune test` checks that the committed files are up to date (run `dune
; promote` after changing the rules), and CI checks them with `lake build`.

(rule
 (deps
  (glob_files %{project_root}/soteria/lib/tiny_values/rules/*.{kn,knl}))
 (targets
  Types.lean.gen
  Syntax.lean.gen
  Signatures.lean.gen
  Typing.lean.gen
  Model.lean.gen
  Statements.lean.gen
  Lifts.lean.gen
  Soundness.lean.gen)
 (action
  (run
   %{bin:kanon}
   lean-all
   %{project_root}/soteria/lib/tiny_values/rules/lang.knl)))

(rule
 (alias runtest)
 (action
  (progn
   (diff Types.lean Types.lean.gen)
   (diff Syntax.lean Syntax.lean.gen)
   (diff Signatures.lean Signatures.lean.gen)
   (diff Typing.lean Typing.lean.gen)
   (diff Model.lean Model.lean.gen)
   (diff Statements.lean Statements.lean.gen)
   (diff Lifts.lean Lifts.lean.gen)
   (diff Soundness.lean Soundness.lean.gen))))
