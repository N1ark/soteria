(* The language of Tiny_values, in which the rules of this directory are
   written: booleans and mathematical integers. Its OCaml types are those of
   [Svalue]; see [soteria/lib/bv_values/rules/lang.bvl] for the attributes.
   [[@literal "int"]] marks integer literals: [0], [1], ... match them, and [#x]
   (or [Int x]) binds their value, an [int]. *)

type kind [@ocaml "t_kind"] [@noeq] =
  | Var of var
  | Bool of bool [@literal]
  | Int of int [@literal "int"]
  | Unop of unop * t [@operators]
  | Binop of binop * t * t [@operators]
  | Nop of nop * t list [@operators]
  | Ite of t * t * t

type unop [@ocaml "Unop.t"] =
  | Not

type binop [@ocaml "Binop.t"] =
  | And [@comm]
  | Or [@comm]
  | Eq [@comm]
  | Leq
  | Lt
  | Plus [@comm]
  | Minus
  | Times [@comm]
  | Div
  | Rem
  | Mod

type nop [@ocaml "Nop.t"] =
  | Distinct

type ty =
  | TBool
  | TInt

infix "+" = Plus, add
infix "-" = Minus, sub
infix "*" = Times, mul
infix "&&" = And, and_
infix "||" = Or, or_
infix "==" = Eq, sem_eq
prefix "not" = Not, not_
