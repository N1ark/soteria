(* The language of Tiny_values, in which the rules of this directory are
   written: booleans and mathematical integers. It is made of the modules it
   uses, [bool], built into kanon and shared with other languages, and [int].
   This file declares its types, as the OCaml types of [Svalue] have them, in
   which Kanon places the nodes of its modules; see the README of Kanon for the
   syntax and attributes.

   The Lean model lives in the namespace [Tiny], in [../lean/Tiny]. *)

[@@@lean_root "Tiny"]

use +bool
use "int"

type var [@ocaml "Symex.Var.t"] [@lean "Int"] [@noeq]

type kind [@ocaml "t_kind"] [@noeq] =
  | Var of var
  | Unop of unop * t [@operators]
  | Binop of binop * t * t [@operators]
  | Nop of nop * t list [@operators]

type unop [@ocaml "Unop.t"]
type binop [@ocaml "Binop.t"]

type nop [@ocaml "Nop.t"] =
  | Distinct

type ty
