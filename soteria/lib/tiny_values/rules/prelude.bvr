(* Primitives and pure helpers used by the rules. Primitives are implemented by
   hand in svalue.ml. *)

(* {1 Primitives} *)

(* Terms *)
prim equal : t -> t -> bool
prim ty : t -> ty
prim kind : t -> kind

(* Whether [l] comes before [r] in the (arbitrary) hash-consing order. *)
oracle tag_le : t -> t -> bool

prim v_true : t
prim v_false : t
prim int_z : int -> t
prim zero : t
prim one : t
prim var_equal : var -> var -> bool

(* Integers: division and remainder truncate towards zero, and fail on a zero
   divisor *)
prim tdiv : int -> int -> int
prim trem : int -> int -> int
prim divisible : int -> int -> bool

(* {1 Helpers} *)

fn of_bool (b : bool) : t = if b then v_true else v_false
fn abs (z : int) : int = if z < 0 then -z else z

(* [mk_commut_binop op l r] puts commutative binary operators in some normal
   form where the element with the smallest tag is on the left. *)
fn mk_commut_binop (op : binop) (l r : t) : kind =
  if tag_le l r then Binop (op, l, r) else Binop (op, r, l)

fn sure_neq (a b : t) : bool =
  (not (ty a = ty b))
  ||
  match (a, b) with
  | Int a, Int b -> not (a = b)
  | Bool a, Bool b -> not (a = b)
  | _ -> false

(* whether [v] is surely a multiple of [n] *)
fn is_mod (v : t) (n : int) : bool =
  match v with
  | Int i -> trem i n = 0
  | Plus (a, b) -> is_mod a n && is_mod b n
  | Minus (a, b) -> is_mod a n && is_mod b n
  | Times (a, b) -> is_mod a n || is_mod b n
  | _ -> false
