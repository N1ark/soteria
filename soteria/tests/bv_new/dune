; The generated files are committed (see regen.sh) and are not generated by
; dune: the kanon of the dune environment is the old, pinned one. Dune ignores
; file names with two dots as modules, hence the copies.

(rule
 (copy bv_types.gen.ml bv_types.ml))

(rule
 (copy bv_rules.gen.ml bv_rules.ml))

(library
 (name bv_new)
 (modules bv_new bv_types bv_prims bv_rules)
 (libraries soteria floatml iter zarith))

(test
 (name test_bv_new)
 (modules test_bv_new)
 (libraries bv_new soteria floatml zarith alcotest))
