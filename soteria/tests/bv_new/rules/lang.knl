(* The language of the standalone Bv_values stack under test: the C language of
   Soteria, written for the new Kanon, which generates its types
   ([Bv_types]) and its simplifying smart constructors ([Bv_rules]).

   It is made of the modules that it uses: [bool], built into kanon, then
   [exists], [bitvec], [float] and [ptr], in this order, each declared by its
   [.knl] file with its rules in its [.kn] file. A module declares its nodes and
   sorts; this file adds the variables and sequences (and their sort), and the
   host types of the nodes' parameters.

   The host types are those of Soteria's own [Svalue] ([[@ocaml "..."]]), so
   that the tests of this directory can share the values of the old and of the
   new stack: [var], [checked], and the enumerations [fp], [rm] and [fc]. Kanon
   re-exports each of them ([type fp = M.fp = F16 | ...]), and OCaml checks it
   against the declaration. *)

[@@@lean_root "Kanon"]
[@@@lean_param "FS" "FloatSem"]
[@@@ocaml_prims "Bv_prims"]
[@@@ocaml_types "Bv_types"]

[@@@ghost "sint" "[ `NonZero | `Zero ]"]
[@@@ghost "sint_ovf" "[ sint | `Overflowed ]"]
[@@@ghost "nonzero" "[ `NonZero ]"]
[@@@ghost "zero" "[ `Zero ]"]
[@@@ghost "sfloat" "[ `Float ]"]
[@@@ghost "sptr" "[ `Ptr ]"]
[@@@ghost "sloc" "[ `Loc ]"]
[@@@ghost "'a sseq" "[ `List of 'a ]"]
[@@@ghost "cval" "[ sint | sptr | sfloat ]"]
[@@@ghost "any" "[ sint_ovf | sfloat | sbool | sptr | sloc | any sseq ]"]

use builtin "bool"
use "exists"
use "bitvec"
use "float"
use "ptr"

type var [@ocaml "Soteria.Symex.Var.t"] [@lean "Int"]
    [@equal "Soteria.Symex.Var.equal"] [@hash "Soteria.Symex.Var.hash"]

(* Floats are compared and hashed bit by bit ([NaN] is equal to itself) *)
type float [@ocaml "Floatml.AnyFloat.t"] [@noeq]
    [@equal "Floatml.AnyFloat.equal"] [@hash "Floatml.AnyFloat.hash"]

type checked [@ocaml "Soteria.Bv_values.Svalue.checked"] =
  { signed : bool; unsigned : bool }

node Var of var
node Seq of t list

sort TSeq of ty [@ghost sseq]

type fp [@ocaml "Soteria.Bv_values.Svalue.FloatPrecision.t"] =
  | F16
  | F32
  | F64
  | F128

type rm [@ocaml "Soteria.Bv_values.Svalue.RoundingMode.t"] =
  | NearestTiesToEven
  | Truncate
  | Ceil
  | Floor
  | NearestTiesToAway

type fc [@ocaml "Soteria.Bv_values.Svalue.FloatClass.t"] =
  | Normal
  | Subnormal
  | Zero
  | Infinite
  | NaN
use "view"
