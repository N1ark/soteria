; Differential tests of the rule functions of Bv_values, generated from the
; rules by kanon.

(rule
 (targets rules_diff.gen.ml)
 (action
  (with-stdout-to
   %{targets}
   (run
    %{bin:kanon}
    ocaml-tests
    %{dep:../../lib/bv_values/rules/lang.knl}
    +bool.knl
    %{dep:../../kanon/modules/exists.knl}
    %{dep:../../lib/bv_values/rules/bitvec.knl}
    %{dep:../../lib/bv_values/rules/float.knl}
    %{dep:../../lib/bv_values/rules/ptr.knl}
    +bool.kn
    %{dep:../../kanon/modules/exists.kn}
    %{dep:../../lib/bv_values/rules/bitvec.kn}
    %{dep:../../lib/bv_values/rules/float.kn}
    %{dep:../../lib/bv_values/rules/ptr.kn}))))

(test
 (name rules_diff)
 (libraries soteria floatml hc zarith fmt)
 (preprocess
  (pps kanon.ppx_include_file))
 (preprocessor_deps
  (file rules_diff.gen.ml)))
